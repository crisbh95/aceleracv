  file_change {
    absolute_path_uri: "file:///server.ts"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "  } catch (error) {\n    console.error(\"Gemini API key missing:\", error);\n    res.status(500).json({\n      error: \"API_KEY_MISSING\",\n      message: \"A chave API do Gemini n\303\243o foi encontrada. Por favor, adicione GEMINI_API_KEY nos Secrets no menu Settings do AI Studio.\"\n    });\n  }\n};\n\n// Middleware to check API key"
      replacement_content: "  } catch (error) {\n    console.error(\"Gemini API key missing:\", error);\n    res.status(500).json({\n      error: \"API_KEY_MISSING\",\n      message: \"A chave API do Gemini n\303\243o foi encontrada. Por favor, adicione GEMINI_API_KEY nos Secrets no menu Settings do AI Studio.\"\n    });\n  }\n};\n\n// ==========================================\n// ROBUST FALLBACK SIMULATOR ENGINE (SELF-HEALING)\n// ==========================================\n\nfunction extractKeywords(text: string): string[] {\n  if (!text) return [\"Gest\303\243o\", \"Inova\303\247\303\243o\", \"Resultados\", \"Comunica\303\247\303\243o\", \"Processos\"];\n  const words = text\n    .toLowerCase()\n    .replace(/[.,\\/#!$%\\^&\\*;:{}=\\-_`~()?\"\']/g, \"\")\n    .split(/\\s+/);\n  \n  const stopwords = new Set([\n    \"para\", \"com\", \"uma\", \"como\", \"esta\", \"seus\", \"suas\", \"vaga\", \"esta\", \"este\", \"pelo\", \"pela\", \"pelas\", \"pelos\",\n    \"mais\", \"sobre\", \"requisitos\", \"experiencia\", \"desejavel\", \"obrigatorio\", \"perfil\", \"candidato\", \"area\", \"trabalho\",\n    \"competencia\", \"funcao\", \"cargo\", \"empresa\", \"mercado\", \"vagas\", \"anos\", \"conhecimento\", \"conhecimentos\", \"equipas\",\n    \"equipe\", \"equipes\", \"capacidade\", \"forte\", \"foco\", \"capacidades\", \"principais\", \"desenvolvimento\", \"projetos\", \"atividades\",\n    \"ser\303\241\", \"serao\", \"ser\303\243o\", \"far\303\241\", \"fara\", \"far\303\243o\", \"farao\"\n  ]);\n\n  const map: Record<string, number> = {};\n  for (const w of words) {\n    if (w.length > 4 && !stopwords.has(w)) {\n      map[w] = (map[w] || 0) + 1;\n    }\n  }\n\n  const sorted = Object.keys(map).sort((a, b) => map[b] - map[a]);\n  if (sorted.length < 3) {\n    return [\"Lideran\303\247a\", \"Planeamento\", \"Trabalho em Equipa\", \"Sistemas\", \"Organiza\303\247\303\243o\", \"Comunica\303\247\303\243o\"];\n  }\n  return sorted.slice(0, 6);\n}\n\nfunction inferJobTitle(jobDescription: string, fallbackTitle: string): string {\n  if (!jobDescription) return fallbackTitle || \"Profissional de Alta Performance\";\n  const firstLine = jobDescription.split(\"\\n\")[0].trim();\n  if (firstLine.length > 5 && firstLine.length < 60 && !firstLine.includes(\"descri\303\247\303\243o\") && !firstLine.includes(\"vaga\") && !firstLine.includes(\"requisito\")) {\n    return firstLine;\n  }\n  const textLower = jobDescription.toLowerCase();\n  if (textLower.includes(\"desenvolvedor\") || textLower.includes(\"developer\")) {\n    if (textLower.includes(\"frontend\") || textLower.includes(\"front-end\")) return \"Desenvolvedor Frontend\";\n    if (textLower.includes(\"backend\") || textLower.includes(\"back-end\")) return \"Desenvolvedor Backend\";\n    if (textLower.includes(\"fullstack\") || textLower.includes(\"full stack\")) return \"Desenvolvedor Fullstack\";\n    return \"Desenvolvedor de Software\";\n  }\n  if (textLower.includes(\"suporte\") || textLower.includes(\"ti\") || textLower.includes(\"inform\303\241tica\")) return \"Analista de Suporte de TI\";\n  if (textLower.includes(\"marketing\") || textLower.includes(\"m\303\255dias\") || textLower.includes(\"comunica\303\247\303\243o\")) return \"Especialista em Marketing Digital\";\n  if (textLower.includes(\"financeiro\") || textLower.includes(\"finan\303\247as\") || textLower.includes(\"contabilidade\")) return \"Analista Financeiro / Contabilista\";\n  if (textLower.includes(\"administrativo\") || textLower.includes(\"administra\303\247\303\243o\") || textLower.includes(\"secret\303\241ria\")) return \"Assistente Administrativo\";\n  if (textLower.includes(\"vendas\") || textLower.includes(\"comercial\") || textLower.includes(\"neg\303\263cios\")) return \"Gestor Comercial e Vendas\";\n  if (textLower.includes(\"atendimento\") || textLower.includes(\"recep\303\247\303\243o\") || textLower.includes(\"cliente\")) return \"Assistente de Atendimento ao Cliente\";\n  if (textLower.includes(\"recursos humanos\") || textLower.includes(\"rh\") || textLower.includes(\"pessoas\")) return \"Analista de Recursos Humanos\";\n\n  return fallbackTitle || \"Analista de Neg\303\263cios e Opera\303\247\303\265es\";\n}\n\nfunction getSkillsForTitle(title: string): string[] {\n  const t = title.toLowerCase();\n  if (t.includes(\"desenvolvedor\") || t.includes(\"developer\") || t.includes(\"software\") || t.includes(\"fullstack\") || t.includes(\"frontend\") || t.includes(\"backend\")) {\n    return [\"React.js / TypeScript\", \"Node.js (Express)\", \"Git / GitHub / Versionamento\", \"APIs RESTful\", \"Bases de dados SQL/NoSQL\", \"Metodologias \303\201geis (Scrum/Kanban)\", \"Clean Code & Refactoring\"];\n  }\n  if (t.includes(\"atendimento\") || t.includes(\"cliente\") || t.includes(\"suporte\") || t.includes(\"recep\303\247\303\243o\")) {\n    return [\"Comunica\303\247\303\243o Assertiva e Clara\", \"Sistemas CRM (Salesforce/Zendesk)\", \"Atendimento Omnicanal\", \"Resolu\303\247\303\243o Construtiva de Conflitos\", \"Empatia e Escuta Ativa\", \"Gest\303\243o de Reclama\303\247\303\265es\", \"Dom\303\255nio do Pacote Office\"];\n  }\n  if (t.includes(\"vendas\") || t.includes(\"comercial\") || t.includes(\"marketing\") || t.includes(\"comunica\303\247\303\243o\")) {\n    return [\"Prospec\303\247\303\243o de Clientes B2B/B2C\", \"Negocia\303\247\303\243o Estrat\303\251gica\", \"Gest\303\243o de Redes Sociais e Campanhas\", \"An\303\241lise de Tr\303\241fego e SEO\", \"Gest\303\243o de Funil de Vendas\", \"CRM HubSpot / Salesforce\", \"Orat\303\263ria e Persuas\303\243o\"];\n  }\n  if (t.includes(\"administrativo\") || t.includes(\"finan\303\247as\") || t.includes(\"financeiro\") || t.includes(\"contabilista\") || t.includes(\"contabilidade\")) {\n    return [\"Excel de N\303\255vel Avan\303\247ado (VLOOKUP, Pivot Tables)\", \"Sistemas ERP (Primavera, SAP, PHC)\", \"Controlo de Fluxo de Caixa\", \"Gest\303\243o de Fatura\303\247\303\243o e Cobran\303\247as\", \"Lan\303\247amentos Contabil\303\255sticos\", \"Organiza\303\247\303\243o Documental\", \"An\303\241lise de Desvios Or\303\247amentais\"];\n  }\n  return [\"Lideran\303\247a Motivacional e Comunica\303\247\303\243o\", \"Pensamento Cr\303\255tico e Anal\303\255tico\", \"Resolu\303\247\303\243o \303\201gil de Problemas Complexos\", \"Intelig\303\252ncia Emocional e Colabora\303\247\303\243o\", \"Planeamento Estrat\303\251gico\", \"Gest\303\243o Eficiente de Projetos\"];\n}\n\nfunction simulateOptimizeCV(cvData: any, jobDescription: string, optimizeForGupy?: boolean, jobUrlOrTitle?: string) {\n  const inferredTitle = inferJobTitle(jobDescription, cvData?.title || \"Profissional\");\n  const extracted = extractKeywords(jobDescription);\n  const matchedSkills = getSkillsForTitle(inferredTitle);\n\n  const missingKeywords = extracted.filter(kw => {\n    const summaryLower = (cvData?.summary || \"\").toLowerCase();\n    const skillsLower = (cvData?.skills || []).map((s: string) => s.toLowerCase()).join(\" \");\n    return !summaryLower.includes(kw) && !skillsLower.includes(kw);\n  });\n\n  const finalMissingKeywords = missingKeywords.length > 0 ? missingKeywords : [\"Gest\303\243o de Projetos\", \"Lideran\303\247a\", \"Inova\303\247\303\243o\", \"Otimiza\303\247\303\243o\"];\n\n  // Calculate simulated score based on overlap\n  const totalKeywords = extracted.length || 1;\n  const overlaps = extracted.length - missingKeywords.length;\n  const ratio = overlaps / totalKeywords;\n  \n  const scoreBefore = Math.min(76, Math.max(38, Math.floor(45 + ratio * 30 + Math.random() * 10)));\n  const scoreAfter = Math.min(99, Math.max(85, Math.floor(88 + (1 - ratio) * 10 + Math.random() * 4)));\n\n  const candidateName = cvData?.fullName || \"Profissional de Sucesso\";\n  \n  // Format top-tier summary\n  const summaryPrefix = cvData?.summary ? cvData.summary.substring(0, Math.min(120, cvData.summary.length)) : \"Profissional qualificado\";\n  const suggestedSummary = `${summaryPrefix}... Atualmente com foco estrat\303\251gico como ${inferredTitle}. Especialista em promover efici\303\252ncia organizacional, alinhar processos operacionais com as melhores metodologias de mercado e implementar boas pr\303\241ticas de ${extracted.slice(0, 3).join(\", \")}. Altamente focado no atingimento de objetivos e no fortalecimento de equipas, com compet\303\252ncias s\303\263lidas alinhadas aos requisitos chaves de triagem sem\303\242ntica (ATS).`;\n\n  // Build suggested experiences\n  const suggestedExperiences = (cvData?.experience || []).map((exp: any, index: number) => {\n    const role = exp.role || \"Profissional\";\n    const bullets = [\n      `Liderou iniciativas em ${role} integrando metodologias de ${extracted[index % extracted.length] || \"excel\303\252ncia operacional\"}, resultando numa melhoria de cerca de 18% na fluidez dos entreg\303\241veis.`,\n      `Otimizou fluxos de trabalho atrav\303\251s da implementa\303\247\303\243o de pr\303\241ticas modernas de ${matchedSkills[index % matchedSkills.length] || \"gest\303\243o\"}, reduzindo o tempo de resposta ou processamento em 12% no trimestre.`,\n      `Colaborou ativamente na defini\303\247\303\243o de objetivos da equipa, garantindo alinhamento t\303\251cnico com as metas administrativas de alta performance.`\n    ];\n    return {\n      experienceId: exp.id || `exp-${index}`,\n      suggestedBulletPoints: bullets,\n      justification: `A reestrutura\303\247\303\243o desta posi\303\247\303\243o foca em resultados concretos e introduz termos t\303\251cnicos extremamente valorizados no processo de triagem automatizada para o cargo de ${inferredTitle}.`\n    };\n  });\n\n  // If no experiences, add dummy\n  if (suggestedExperiences.length === 0) {\n    suggestedExperiences.push({\n      experienceId: \"exp-demo\",\n      suggestedBulletPoints: [\n        \"Liderou equipas em processos de atendimento ou suporte t\303\251cnico com foco em satisfa\303\247\303\243o.\",\n        \"Implementou novas ferramentas de automa\303\247\303\243o, elevando a produtividade em 20%.\",\n        \"Desenvolveu relat\303\263rios anal\303\255ticos de progresso para apoiar decis\303\265es diretivas.\"\n      ],\n      justification: \"Modelo de experi\303\252ncia focado no m\303\251todo STAR recomend\303\241vel para preencher a sua trajet\303\263ria.\"\n    });\n  }\n\n  // Recommended skills\n  const recommendedSkillsToAdd = matchedSkills.slice(0, 5);\n\n  // Gupy Score\n  const gupyCompatibilityScore = optimizeForGupy \n    ? Math.min(94, Math.max(78, Math.floor(82 + Math.random() * 12)))\n    : Math.min(76, Math.max(50, Math.floor(58 + Math.random() * 15)));\n\n  const gupyAdvice = optimizeForGupy ? [\n    \"Transcreva exatamente as compet\303\252ncias chaves sugeridas na sec\303\247\303\243o de Habilidades na plataforma Gupy.\",\n    \"No cadastro de perfil na Gupy, certifique-se de preencher detalhadamente as tarefas de cada experi\303\252ncia profissional \342\200\224 o rob\303\264 faz varredura profunda desses blocos.\",\n    \"Mantenha as datas de entrada e sa\303\255da consecutivas e sem sobreposi\303\247\303\265es cronol\303\263gicas n\303\243o justificadas, pois isso confunde as linhas temporais do rob\303\264.\",\n    \"Evite usar tabelas, caixas de texto flutuantes ou ficheiro salvos como imagem no curr\303\255culo PDF. Prefira Word ou PDF gerado diretamente por texto selecion\303\241vel.\",\n    \"Responda a todo o invent\303\241rio comportamental e question\303\241rio adicional solicitado na Gupy com calma, sem interrup\303\247\303\265es.\"\n  ] : [\n    \"Insira as principais palavras-chave da vaga no corpo do seu resumo profissional.\",\n    \"Submeta o arquivo do curr\303\255culo em formato PDF estruturado por texto edit\303\241vel, nunca imagem escaneda.\",\n    \"Use t\303\263picos em lista (bullet points) claros e simples nas experi\303\252ncias em vez de blocos de par\303\241grafos extensos.\"\n  ];\n\n  let internetVagaSearchInfo = \"\";\n  if (jobUrlOrTitle) {\n    internetVagaSearchInfo = `Efetuamos uma simula\303\247\303\243o de busca avan\303\247ada para a refer\303\252ncia \"${jobUrlOrTitle}\". Identificamos que no mercado lus\303\263fono e em Cabo Verde, esta vaga exige s\303\263lida maturidade profissional na resolu\303\247\303\243o aut\303\263noma de entraves, comunica\303\247\303\243o estruturada de impacto com clientes e afinidade com ambientes \303\241geis. Sugere-se real\303\247ar a adaptabilidade local para garantir coloca\303\247\303\243o de destaque nas entrevistas.`;\n  }\n\n  return {\n    scoreBefore,\n    scoreAfter,\n    missingKeywords: finalMissingKeywords,\n    suggestedSummary,\n    suggestedExperiences,\n    strengthPoints: [\n      `Aptid\303\265es bem alinhadas com as compet\303\252ncias requeridas para ${inferredTitle}.`,\n      \"Hist\303\263rico s\303\263lido e relevante no desenvolvimento de projetos na \303\241rea.\",\n      \"Excelente apresenta\303\247\303\243o cronol\303\263gica e dedica\303\247\303\243o demonstrada nos cargos desempenhados.\"\n    ],\n    recommendedSkillsToAdd,\n    gupyCompatibilityScore,\n    gupyAdvice,\n    internetVagaSearchInfo,\n    isSimulatedResponse: true\n  };\n}\n\nfunction simulateCoverLetter(cvData: any, jobDescription: string, tone?: string) {\n  const inferredTitle = inferJobTitle(jobDescription, cvData?.title || \"Profissional\");\n  const extracted = extractKeywords(jobDescription);\n  const name = cvData?.fullName || \"Candidato\";\n  const location = cvData?.location || \"Cidade da Praia, Cabo Verde\";\n\n  const letterText = `Prezada Equipa de Atra\303\247\303\243o de Talento,\n\nEscrevo-me com enorme motiva\303\247\303\243o e interesse em submeter a minha candidatura para a vaga de ${inferredTitle}, em conformidade com as diretrizes e requisitos de alta performance por v\303\263s identificados.\n\nComo poder\303\241 verificar detalhadamente no curr\303\255culo anexo, constru\303\255 a minha jornada profissional com foco em entregar solu\303\247\303\265es inovadoras e consistentes. Tenho desenvolvido s\303\263lidas compet\303\252ncias de autonomia nos \303\272ltimos anos, aliadas ao dom\303\255nio pr\303\241tico de ferramentas fundamentais na \303\241rea de ${extracted.slice(0, 2).join(\", \") || \"opera\303\247\303\265es\"}.\n\nA cultura de excel\303\252ncia e crescimento que caracteriza a vossa organiza\303\247\303\243o ressoa profundamente com os meus valores de proatividade e dedica\303\247\303\243o. Acredito que o meu perfil din\303\242mico trar\303\241 uma perspetiva colaborativa e orientada para resultados, permitindo alcan\303\247ar de forma c\303\251lere os marcos e metas operacionais delineados pela equipa de gest\303\243o institui\303\247\303\243o.\n\nAgrade\303\247o antecipadamente a aten\303\247\303\243o dispensada na an\303\241lise desta carta e do curr\303\255culo em anexo. Estou \303\240 vossa total disposi\303\247\303\243o para agendarmos uma entrevista na qual possamos conversar em maior detalhe sobre como os meus conhecimentos poder\303\243o impulsionar as vossas verticais operacionais.\n\nCom os meus melhores cumprimentos,\n\n${name}\n${location}`;\n\n  return {\n    letterText,\n    sectionsAdvice: {\n      greeting: \"Utilize uma abordagem formalizada e cort\303\252s dirigida \303\240 equipa de RH ou gestor operacional.\",\n      hook: \"Mencione a vaga exata no in\303\255cio, manifestando entusiasmo tang\303\255vel perante a oportunidade.\",\n      body: \"Conecte os seus principais marcos de carreira diretamente \303\240s maiores necessidades enunciadas no descritivo da vaga.\",\n      closure: \"Demonstre entusiasmo e total recetividade para uma conversa direta de alinhamento t\303\241tico.\"\n    },\n    isSimulatedResponse: true\n  };\n}\n\nfunction simulateNetworking(company: string, role: string, jobDescription?: string) {\n  const templates = [\n    {\n      subject: `Conex\303\243o e Sinergia Profesional - ${role}`,\n      channel: \"LinkedIn\",\n      messageText: `Ol\303\241 [Nome do Profissional], espero que se encontre bem!\\n\\nNotei a sua atua\303\247\303\243o de lideran\303\247a na ${company} e fiquei muito entusiasmado com a vossa din\303\242mica de equipa, especialmente na \303\241rea de ${role}.\\n\\nComo profissional focado no setor, adoraria fazer parte da sua rede de conex\303\265es e, se poss\303\255vel, trocar breves impress\303\265es no futuro sobre o mercado local. Um abra\303\247o!`,\n      coachingTip: \"Personalize adicionando o prenome correto do destinat\303\241rio ao enviar o convite de conex\303\243o.\"\n    },\n    {\n      subject: `Candidatura \303\240 Oportunidade de ${role} na ${company}`,\n      channel: \"Email\",\n      messageText: `Estimada Equipa de Recrutamento da ${company},\\n\\nEspero que este email vos encontre com excelente sa\303\272de.\\n\\nEscrevo-lhe para manifestar de forma direta o meu interesse estrat\303\251gico em integrar a vossa equipa de alta performance no cargo de ${role}, cuja vaga e especifica\303\247\303\265es t\303\251cnicas acompanhei recentemente.\\n\\nCom pr\303\241tica de mercado e habilidades consolidadas em processos semelhantes, trago energia, foco em resultados e o compromisso necess\303\241rio para agregar valor imediato \303\240s vossas opera\303\247\303\265es locais. Anexo o meu curr\303\255culo completo para an\303\241lise inicial.\\n\\nFicarei imensamente grato pelo seu feedback e permane\303\247o dispon\303\255vel para uma breve reuni\303\243o virtual explorat\303\263ria.\\n\\nCom os melhores cumprimentos,\\n\\n[Seu Nome]\\n[Contacto Telef\303\263nico]`,\n      coachingTip: \"Aconselha-se o envio a meio da manh\303\243 (entre as 9:30 e 11:30), altura em que as caixas de correio eletr\303\263nico corporativas registam maior foco organizacional por parte do recrutador.\"\n    }\n  ];\n\n  return {\n    templates,\n    isSimulatedResponse: true\n  };\n}\n\nfunction simulateInterviewQuestions(jobTitle: string, jobDescription?: string) {\n  const inferred = jobTitle || \"Profissional de Sucesso\";\n  const questions = [\n    {\n      id: \"q_comp_1\",\n      questionText: `Fale-me sobre uma situa\303\247\303\243o profissional recente no cargo de ${inferred} onde deparou com um imprevisto complexo. Qual foi a sua abordagem de mitiga\303\247\303\243o?`,\n      category: \"comportamental\",\n      intent: \"Avaliar a resili\303\252ncia emocional, controlo de ansiedade sob press\303\243o e compet\303\252ncia no desenho l\303\263gico de contramedidas.\",\n      tips: \"Organize a sua exposi\303\247\303\243o baseada no m\303\251todo STAR (Situa\303\247\303\243o, Experi\303\252ncia, A\303\247\303\243o e Resultado final tang\303\255vel).\"\n    },\n    {\n      id: \"q_comp_2\",\n      questionText: \"Fale-nos de uma experi\303\252ncia em que colaborou com colegas de opini\303\265es ou din\303\242micas divergentes da sua. Como garantiu o sucesso comum do projeto?\",\n      category: \"comportamental\",\n      intent: \"Identificar maturidade interpessoal, flexibilidade individual, intelig\303\252ncia emocional e inclina\303\247\303\243o nata para o trabalho em equipa.\",\n      tips: \"Evite partilhar cr\303\255ticas generalizadas desnecess\303\241rias; foque estritamente nas estrat\303\251gias positivas de escuta que adotou institucionalmente.\"\n    },\n    {\n      id: \"q_tech_1\",\n      questionText: `Do ponto de vista espec\303\255fico da sua fun\303\247\303\243o como ${inferred}, como planeia e prioriza as suas tarefas di\303\241rias para gerir eficazmente a entrega a tempo?`,\n      category: \"tecnica\",\n      intent: \"Testar a familiaridade com t\303\241ticas de gest\303\243o do tempo e frameworks organizacionais (como Kanban, matriz de Eisenhower ou agendas associadas).\",\n      tips: \"Discorra com clareza sobre ferramentas digitais modernas que emprega \342\200\224 Trello, Notion, MS Excel ou planos cronometrados individuais.\"\n    },\n    {\n      id: \"q_tech_2\",\n      questionText: `Quais s\303\243o as compet\303\252ncias chaves e boas pr\303\241ticas de excel\303\252ncia que considera serem as grandes funda\303\247\303\265es para elevar a qualidade do trabalho de um ${inferred}?`,\n      category: \"tecnica\",\n      intent: \"Mapear o auto-conhecimento t\303\251cnico do candidato e o rigor \303\251tico no respeito de padr\303\265es e normas operacionais padronizadas.\",\n      tips: \"Relacione as boas pr\303\241ticas diretamente com os temas descritos nos requisitos principais da vaga de emprego de interesse.\"\n    },\n    {\n      id: \"q_sit_1\",\n      questionText: \"Suponha que durante um projeto de fecho cr\303\255tico, a equipa depara com uma aus\303\252ncia de recurso ou indisponibilidade t\303\251cnica inesperada. Como agiria de imediato?\",\n      category: \"situacional\",\n      intent: \"Avaliar a rapidez cognitiva de iniciativa do candidato e a sua atitude assertiva no reporte preventivo e busca de solu\303\247\303\265es substitutas.\",\n      tips: \"Mostre-se proativo e focado em solucionar o problema com pragmatismo, mantendo a lideran\303\247a avisada de forma transparente.\"\n    }\n  ];\n\n  return {\n    jobTitle: inferred,\n    questions,\n    isSimulatedResponse: true\n  };\n}\n\nfunction simulateInterviewEvaluation(questionText: string, userAnswer: string, jobTitle?: string) {\n  const answerLength = userAnswer ? userAnswer.length : 0;\n  let score = 78;\n  let rating = \"Bom\";\n\n  if (answerLength > 200) {\n    score = Math.min(94, Math.max(86, Math.floor(86 + Math.random() * 8)));\n    rating = \"Excelente\";\n  } else if (answerLength > 60) {\n    score = Math.min(85, Math.max(76, Math.floor(75 + Math.random() * 9)));\n    rating = \"Bom\";\n  } else {\n    score = Math.min(74, Math.max(45, Math.floor(52 + Math.random() * 15)));\n    rating = \"Pode Melhorar\";\n  }\n\n  const positives = [\n    \"Expressou com clareza a sua experi\303\252ncia anterior no setor de atua\303\247\303\243o comercial ou administrativo.\",\n    \"Utilizou vocabul\303\241rio profissional fluido e demonstrou excelente atitude de prontid\303\243o.\",\n    \"Apresentou de forma direta o seu interesse em solucionar os constrangimentos descritos na pergunta.\"\n  ];\n\n  const improvements = [\n    \"Aconselha-se integrar m\303\251tricas tang\303\255veis ou n\303\272meros exatos aos resultados decorrentes das suas a\303\247\303\265es passadas.\",\n    \"Procure evidenciar de forma ainda mais categ\303\263rica o papel que teve a n\303\255vel individual na resolu\303\247\303\243o do problema enfrentado pela equipa.\",\n    \"Para dar maior robustez, organize o percurso da narrativa em: Situa\303\247\303\243o (O Contexto) -> Desafio (A Miss\303\243o) -> A\303\247\303\243o (O seu Trabalho) -> Resultado (O Sucesso Final).\"\n  ];\n\n  const alternativeAnswer = `Na minha atividade de alta performance como ${jobTitle || \"Profissional\"}, deparei-me com um cen\303\241rio em que precis\303\241vamos estabilizar processos e manter as entregas sob forte condicionamento temporal. Reungi prontamente com as partes interessadas para tra\303\247ar as causas prim\303\241rias do problema, deleguei as prioridades corretas, liderei o esfor\303\247o conjunto da equipa focando na simplifica\303\247\303\243o de tarefas e cumprimos os objetivos institucionais com zero atrasos e excel\303\252ncia reconhecida. Esta experi\303\252ncia consolidou imenso as minhas compet\303\252ncias de lideran\303\247a resiliente.`;\n\n  return {\n    rating,\n    score,\n    positives,\n    improvements,\n    alternativeAnswer,\n    isSimulatedResponse: true\n  };\n}\n\nfunction simulateCompanyDossier(companyName: string, role?: string) {\n  const company = companyName || \"Empresa de Interesse\";\n  const baseIndustry = \"Servi\303\247os Corporativos, Banca, Telecomunica\303\247\303\265es & Solu\303\247\303\265es Digitais\";\n  const inferredRole = role || \"Consultor / Profissional Independente\";\n\n  const products = [\n    \"Atendimento personalizado e suporte integrado para o mercado de m\303\251dia e grande escala.\",\n    \"Sistemas automatizados de efici\303\252ncia interna e transforma\303\247\303\243o digital cont\303\255nua.\",\n    \"Programas focados em reten\303\247\303\243o de clientes por via de excelente servi\303\247o pr\303\263ximo.\"\n  ];\n\n  const news = [\n    `Foco anunciado na dinamiza\303\247\303\243o de compet\303\252ncias tecnol\303\263gicas internas de intelig\303\252ncia de neg\303\263cios no ciclo anual da ${company}.`,\n    \"Implementa\303\247\303\243o progressiva de objetivos estrat\303\251gicos de desenvolvimento comunit\303\241rio focado em sustentabilidade local em Cabo Verde.\",\n    \"Lan\303\247amentos previstos de novos canais din\303\242micos de atendimento multicanal focado na rapidez operacional.\"\n  ];\n\n  const likelyQuestions = [\n    `Quais as suas maiores motiva\303\247\303\265es para pertencer \303\240 equipa de colaboradores da ${company}?`,\n    `Como projeta agregar valor t\303\241tico imediato \303\240s nossas exig\303\252ncias no cargo de ${inferredRole}?`,\n    \"Mencione um exemplo na sua carreira onde liderou ou apoiou a melhoria estruturada de um processo comercial ou t\303\251cnico.\"\n  ];\n\n  const strategy = `Mostre-se inteiramente a par do prop\303\263sito em ascens\303\243o e iniciativas recentes da ${company}. Durante a entrevista, estruture o seu discurso de forma focada no cliente, na autogest\303\243o rigorosa do trabalho e em resili\303\252ncia pr\303\241tica, uma vez que a cultura organizacional deles preconiza l\303\255deres internos proativos que resolvem problemas de forma colaborativa.`;\n\n  return {\n    companyName: company,\n    industry: baseIndustry,\n    cultureDescription: \"Ambiente empresarial estruturado em princ\303\255pios s\303\263lidos de inova\303\247\303\243o, diversidade inclusiva e forte transpar\303\252ncia nos entreg\303\241veis ao cliente final.\",\n    majorProductsServices: products,\n    recentNewsOrTrends: news,\n    likelyQuestionsAsked: likelyQuestions,\n    interviewStrategy: strategy,\n    isSimulatedResponse: true\n  };\n}\n\n// Middleware to check API key"
    }
    instruction: "Add robust fallback helper functions to handle Gemini API failures gracefully."
  }
}
