  file_change {
    absolute_path_uri: "file:///src/components/ResumeForm.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport React, { useState } from \"react\";\nimport { CVData, WorkExperience, Education } from \"../types\";\nimport { DEV_MOCK_CV, ADM_MOCK_CV } from \"../mockData\";\nimport { Plus, Trash2, Edit2, Check, User, Briefcase, GraduationCap, Code, Languages, FileText, Sparkles, RefreshCw } from \"lucide-react\";\n\ninterface ResumeFormProps {\n  cvData: CVData;\n  onChange: (data: CVData) => void;\n}\n\nexport default function ResumeForm({ cvData, onChange }: ResumeFormProps) {\n  const [newSkill, setNewSkill] = useState(\"\");\n  const [newLang, setNewLang] = useState(\"\");\n\n  const handlePersonalChange = (e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement>) => {\n    onChange({\n      ...cvData,\n      [e.target.name]: e.target.value\n    });\n  };\n\n  const handleImport = (type: \"dev\" | \"adm\") => {\n    if (type === \"dev\") {\n      onChange(DEV_MOCK_CV);\n    } else {\n      onChange(ADM_MOCK_CV);\n    }\n  };\n\n  // Work Experience Operations\n  const handleAddExperience = () => {\n    const newExp: WorkExperience = {\n      id: \"exp_\" + Date.now(),\n      role: \"\",\n      company: \"\",\n      location: \"\",\n      startDate: \"\",\n      endDate: \"\",\n      description: \"\"\n    };\n    onChange({\n      ...cvData,\n      experience: [...cvData.experience, newExp]\n    });\n  };\n\n  const handleUpdateExperience = (id: string, field: keyof WorkExperience, value: string) => {\n    onChange({\n      ...cvData,\n      experience: cvData.experience.map(exp => exp.id === id ? { ...exp, [field]: value } : exp)\n    });\n  };\n\n  const handleRemoveExperience = (id: string) => {\n    onChange({\n      ...cvData,\n      experience: cvData.experience.filter(exp => exp.id !== id)\n    });\n  };\n\n  // Education Operations\n  const handleAddEducation = () => {\n    const newEdu: Education = {\n      id: \"edu_\" + Date.now(),\n      degree: \"\",\n      fieldOfStudy: \"\",\n      school: \"\",\n      location: \"\",\n      startDate: \"\",\n      endDate: \"\"\n    };\n    onChange({\n      ...cvData,\n      education: [...cvData.education, newEdu]\n    });\n  };\n\n  const handleUpdateEducation = (id: string, field: keyof Education, value: string) => {\n    onChange({\n      ...cvData,\n      education: cvData.education.map(edu => edu.id === id ? { ...edu, [field]: value } : edu)\n    });\n  };\n\n  const handleRemoveEducation = (id: string) => {\n    onChange({\n      ...cvData,\n      education: cvData.education.filter(edu => edu.id !== id)\n    });\n  };\n\n  // Skills & Languages\n  const handleAddSkill = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (newSkill.trim() && !cvData.skills.includes(newSkill.trim())) {\n      onChange({\n        ...cvData,\n        skills: [...cvData.skills, newSkill.trim()]\n      });\n      setNewSkill(\"\");\n    }\n  };\n\n  const handleRemoveSkill = (skill: string) => {\n    onChange({\n      ...cvData,\n      skills: cvData.skills.filter(s => s !== skill)\n    });\n  };\n\n  const handleAddLanguage = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (newLang.trim() && !cvData.languages.includes(newLang.trim())) {\n      onChange({\n        ...cvData,\n        languages: [...cvData.languages, newLang.trim()]\n      });\n      setNewLang(\"\");\n    }\n  };\n\n  const handleRemoveLanguage = (lang: string) => {\n    onChange({\n      ...cvData,\n      languages: cvData.languages.filter(l => l !== lang)\n    });\n  };\n\n  return (\n    <div id=\"resume-form-container\" className=\"space-y-8 animate-fade-in\">\n      {/* Templates Selector */}\n      <div id=\"templates-selector-card\" className=\"bg-gradient-to-r from-emerald-50 to-teal-50 border border-emerald-100 rounded-2xl p-6 shadow-xs flex flex-col md:flex-row justify-between items-start md:items-center gap-4\">\n        <div>\n          <h3 id=\"template-card-title\" className=\"text-emerald-950 font-display font-semibold text-lg flex items-center gap-2\">\n            <Sparkles className=\"w-5 h-5 text-emerald-600\" />\n            Precisa de um exemplo r\303\241pido para testar?\n          </h3>\n          <p id=\"template-card-description\" className=\"text-emerald-800 text-sm mt-1\">\n            Selecione e importe um perfil de exemplo completo para analisar seu rendimento com a Intelig\303\252ncia Artificial.\n          </p>\n        </div>\n        <div id=\"templates-buttons-div\" className=\"flex gap-2 w-full md:w-auto\">\n          <button\n            id=\"import-dev-btn\"\n            onClick={() => handleImport(\"dev\")}\n            className=\"flex-1 md:flex-none px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-medium text-xs rounded-xl transition duration-200 shadow-sm flex items-center justify-center gap-2\"\n          >\n            <RefreshCw className=\"w-3.5 h-3.5\" />\n            Perfil Inform\303\241tico (Dev)\n          </button>\n          <button\n            id=\"import-adm-btn\"\n            onClick={() => handleImport(\"adm\")}\n            className=\"flex-1 md:flex-none px-4 py-2 bg-teal-600 hover:bg-teal-700 text-white font-medium text-xs rounded-xl transition duration-200 shadow-sm flex items-center justify-center gap-2\"\n          >\n            <RefreshCw className=\"w-3.5 h-3.5\" />\n            Perfil Administrativo\n          </button>\n        </div>\n      </div>\n\n      {/* Personal Info */}\n      <div id=\"personal-info-card\" className=\"bg-white border border-slate-100 rounded-2xl p-6 shadow-xs space-y-4\">\n        <h2 id=\"personal-info-header\" className=\"text-slate-800 font-display font-semibold text-lg flex items-center gap-2 border-b border-slate-50 pb-3\">\n          <User className=\"w-5 h-5 text-emerald-600\" />\n          Dados Pessoais\n        </h2>\n        <div id=\"personal-grid\" className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n          <div>\n            <label className=\"block text-xs font-medium text-slate-600 mb-1\">Nome Completo</label>\n            <input\n              type=\"text\"\n              name=\"fullName\"\n              value={cvData.fullName}\n              onChange={handlePersonalChange}\n              placeholder=\"ex: Carlos Jorge Silva\"\n              className=\"w-full text-sm px-3.5 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition\"\n            />\n          </div>\n          <div>\n            <label className=\"block text-xs font-medium text-slate-600 mb-1\">Email de Contacto</label>\n            <input\n              type=\"email\"\n              name=\"email\"\n              value={cvData.email}\n              onChange={handlePersonalChange}\n              placeholder=\"ex: carlos@mail.cv\"\n              className=\"w-full text-sm px-3.5 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition\"\n            />\n          </div>\n          <div>\n            <label className=\"block text-xs font-medium text-slate-600 mb-1\">Telem\303\263vel / Telefone</label>\n            <input\n              type=\"text\"\n              name=\"phone\"\n              value={cvData.phone}\n              onChange={handlePersonalChange}\n              placeholder=\"ex: +238 991 22 33\"\n              className=\"w-full text-sm px-3.5 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition\"\n            />\n          </div>\n          <div>\n            <label className=\"block text-xs font-medium text-slate-600 mb-1\">Localiza\303\247\303\243o (Cidade, Ilha)</label>\n            <input\n              type=\"text\"\n              name=\"location\"\n              value={cvData.location}\n              onChange={handlePersonalChange}\n              placeholder=\"ex: Praia, Santiago, Cabo Verde\"\n              className=\"w-full text-sm px-3.5 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition\"\n            />\n          </div>\n          <div className=\"md:col-span-2\">\n            <label className=\"block text-xs font-medium text-slate-600 mb-1\">Website / LinkedIn</label>\n            <input\n              type=\"text\"\n              name=\"website\"\n              value={cvData.website || \"\"}\n              onChange={handlePersonalChange}\n              placeholder=\"ex: linkedin.com/in/perfil\"\n              className=\"w-full text-sm px-3.5 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition\"\n            />\n          </div>\n          <div className=\"md:col-span-2\">\n            <label className=\"block text-xs font-medium text-slate-600 mb-1\">Perfil Profissional / Resumo Curto</label>\n            <textarea\n              name=\"summary\"\n              rows={3}\n              value={cvData.summary}\n              onChange={handlePersonalChange}\n              placeholder=\"Breve resumo sobre suas aspira\303\247\303\265es, principais dom\303\255nios e conquistas que o definem estrategicamente...\"\n              className=\"w-full text-sm px-3.5 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition resize-none\"\n            />\n          </div>\n        </div>\n      </div>\n\n      {/* Experience History */}\n      <div id=\"experience-history-card\" className=\"bg-white border border-slate-100 rounded-2xl p-6 shadow-xs space-y-4\">\n        <div className=\"flex justify-between items-center border-b border-slate-50 pb-3\">\n          <h2 id=\"experience-header\" className=\"text-slate-800 font-display font-semibold text-lg flex items-center gap-2\">\n            <Briefcase className=\"w-5 h-5 text-emerald-600\" />\n            Experi\303\252ncia Profissional\n          </h2>\n          <button\n            id=\"add-exp-btn\"\n            type=\"button\"\n            onClick={handleAddExperience}\n            className=\"text-xs text-emerald-600 hover:text-emerald-700 font-medium flex items-center gap-1.5 px-3 py-1.5 bg-emerald-50 hover:bg-emerald-100 transition rounded-xl\"\n          >\n            <Plus className=\"w-4 h-4\" />\n            Adicionar Cargo\n          </button>\n        </div>\n\n        {cvData.experience.length === 0 ? (\n          <p className=\"text-slate-400 text-sm py-4 text-center\">Nenhuma experi\303\252ncia de trabalho listada. Clique em \"Adicionar Cargo\" ou acima em Importar.</p>\n        ) : (\n          <div className=\"space-y-6\">\n            {cvData.experience.map((exp, idx) => (\n              <div key={exp.id} className=\"relative border border-slate-100 rounded-xl p-5 bg-slate-50/40 space-y-4\">\n                <button\n                  type=\"button\"\n                  onClick={() => handleRemoveExperience(exp.id)}\n                  title=\"remover experi\303\252ncia\"\n                  className=\"absolute top-4 right-4 text-slate-400 hover:text-rose-500 transition\"\n                >\n                  <Trash2 className=\"w-4 h-4\" />\n                </button>\n                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                  <div>\n                    <label className=\"block text-xs font-medium text-slate-500 mb-0.5\">T\303\255tulo do Cargo</label>\n                    <input\n                      type=\"text\"\n                      value={exp.role}\n                      onChange={(e) => handleUpdateExperience(exp.id, \"role\", e.target.value)}\n                      placeholder=\"ex: Diretor Comercial, Designer, Programador\"\n                      className=\"w-full text-xs px-3 py-1.5 border border-slate-200 rounded-lg bg-white\"\n                    />\n                  </div>\n                  <div>\n                    <label className=\"block text-xs font-medium text-slate-500 mb-0.5\">Nome da Empresa</label>\n                    <input\n                      type=\"text\"\n                      value={exp.company}\n                      onChange={(e) => handleUpdateExperience(exp.id, \"company\", e.target.value)}\n                      placeholder=\"ex: CV Telecom, Banco de Cabo Verde\"\n                      className=\"w-full text-xs px-3 py-1.5 border border-slate-200 rounded-lg bg-white\"\n                    />\n                  </div>\n                  <div>\n                    <label className=\"block text-xs font-medium text-slate-500 mb-0.5\">In\303\255cio - Fim (Datas)</label>\n                    <div className=\"grid grid-cols-2 gap-2\">\n                      <input\n                        type=\"text\"\n                        value={exp.startDate}\n                        onChange={(e) => handleUpdateExperience(exp.id, \"startDate\", e.target.value)}\n                        placeholder=\"ex: Ago 2021\"\n                        className=\"w-full text-xs px-3 py-1.5 border border-slate-200 rounded-lg bg-white\"\n                      />\n                      <input\n                        type=\"text\"\n                        value={exp.endDate}\n                        onChange={(e) => handleUpdateExperience(exp.id, \"endDate\", e.target.value)}\n                        placeholder=\"ex: Presente\"\n                        className=\"w-full text-xs px-3 py-1.5 border border-slate-200 rounded-lg bg-white\"\n                      />\n                    </div>\n                  </div>\n                  <div>\n                    <label className=\"block text-xs font-medium text-slate-500 mb-0.5\">Localiza\303\247\303\243o</label>\n                    <input\n                      type=\"text\"\n                      value={exp.location}\n                      onChange={(e) => handleUpdateExperience(exp.id, \"location\", e.target.value)}\n                      placeholder=\"ex: Praia, Santiago\"\n                      className=\"w-full text-xs px-3 py-1.5 border border-slate-200 rounded-lg bg-white\"\n                    />\n                  </div>\n                  <div className=\"md:col-span-2\">\n                    <label className=\"block text-xs font-medium text-slate-500 mb-0.5\">Descri\303\247\303\243o de Atribui\303\247\303\265es e Conquistas</label>\n                    <textarea\n                      rows={3}\n                      value={exp.description}\n                      onChange={(e) => handleUpdateExperience(exp.id, \"description\", e.target.value)}\n                      placeholder=\"Detalhes sobre suas rotinas principais, projetos relevantes ou redu\303\247\303\265es de custos/erros que efetuou...\"\n                      className=\"w-full text-xs px-3 py-1.5 border border-slate-200 rounded-lg bg-white resize-none\"\n                    />\n                  </div>\n                </div>\n              </div>\n            ))}\n          </div>\n        )}\n      </div>\n\n      {/* Education */}\n      <div id=\"education-card\" className=\"bg-white border border-slate-100 rounded-2xl p-6 shadow-xs space-y-4\">\n        <div className=\"flex justify-between items-center border-b border-slate-50 pb-3\">\n          <h2 id=\"education-header\" className=\"text-slate-800 font-display font-semibold text-lg flex items-center gap-2\">\n            <GraduationCap className=\"w-5 h-5 text-emerald-600\" />\n            Educa\303\247\303\243o & Forma\303\247\303\243o\n          </h2>\n          <button\n            id=\"add-edu-btn\"\n            type=\"button\"\n            onClick={handleAddEducation}\n            className=\"text-xs text-emerald-600 hover:text-emerald-700 font-medium flex items-center gap-1.5 px-3 py-1.5 bg-emerald-50 hover:bg-emerald-100 transition rounded-xl\"\n          >\n            <Plus className=\"w-4 h-4\" />\n            Adicionar Educa\303\247\303\243o\n          </button>\n        </div>\n\n        {cvData.education.length === 0 ? (\n          <p className=\"text-slate-400 text-sm py-4 text-center\">Nenhuma educa\303\247\303\243o ou curso listado. Clique em \"Adicionar Educa\303\247\303\243o\".</p>\n        ) : (\n          <div className=\"space-y-6\">\n            {cvData.education.map((edu) => (\n              <div key={edu.id} className=\"relative border border-slate-100 rounded-xl p-5 bg-slate-50/40 space-y-4\">\n                <button\n                  type=\"button\"\n                  onClick={() => handleRemoveEducation(edu.id)}\n                  title=\"remover educa\303\247\303\243o\"\n                  className=\"absolute top-4 right-4 text-slate-400 hover:text-rose-500 transition\"\n                >\n                  <Trash2 className=\"w-4 h-4\" />\n                </button>\n                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                  <div>\n                    <label className=\"block text-xs font-medium text-slate-500 mb-0.5\">T\303\255tulo do Curso / Licenciatura</label>\n                    <input\n                      type=\"text\"\n                      value={edu.degree}\n                      onChange={(e) => handleUpdateEducation(edu.id, \"degree\", e.target.value)}\n                      placeholder=\"ex: Licenciatura, Tecn\303\263logo, Mestrado\"\n                      className=\"w-full text-xs px-3 py-1.5 border border-slate-200 rounded-lg bg-white\"\n                    />\n                  </div>\n                  <div>\n                    <label className=\"block text-xs font-medium text-slate-500 mb-0.5\">\303\201rea de Estudo</label>\n                    <input\n                      type=\"text\"\n                      value={edu.fieldOfStudy}\n                      onChange={(e) => handleUpdateEducation(edu.id, \"fieldOfStudy\", e.target.value)}\n                      placeholder=\"ex: Gest\303\243o de Empresas, Inform\303\241tica de Redes\"\n                      className=\"w-full text-xs px-3 py-1.5 border border-slate-200 rounded-lg bg-white\"\n                    />\n                  </div>\n                  <div>\n                    <label className=\"block text-xs font-medium text-slate-500 mb-0.5\">Institui\303\247\303\243o / Escola</label>\n                    <input\n                      type=\"text\"\n                      value={edu.school}\n                      onChange={(e) => handleUpdateEducation(edu.id, \"school\", e.target.value)}\n                      placeholder=\"ex: Universidade de Cabo Verde (Uni-CV)\"\n                      className=\"w-full text-xs px-3 py-1.5 border border-slate-200 rounded-lg bg-white\"\n                    />\n                  </div>\n                  <div>\n                    <label className=\"block text-xs font-medium text-slate-500 mb-0.5\">Datas (In\303\255cio - Fim)</label>\n                    <div className=\"grid grid-cols-2 gap-2\">\n                      <input\n                        type=\"text\"\n                        value={edu.startDate}\n                        onChange={(e) => handleUpdateEducation(edu.id, \"startDate\", e.target.value)}\n                        placeholder=\"ex: 2019\"\n                        className=\"w-full text-xs px-3 py-1.5 border border-slate-200 rounded-lg bg-white\"\n                      />\n                      <input\n                        type=\"text\"\n                        value={edu.endDate}\n                        onChange={(e) => handleUpdateEducation(edu.id, \"endDate\", e.target.value)}\n                        placeholder=\"ex: 2023\"\n                        className=\"w-full text-xs px-3 py-1.5 border border-slate-200 rounded-lg bg-white\"\n                      />\n                    </div>\n                  </div>\n                </div>\n              </div>\n            ))}\n          </div>\n        )}\n      </div>\n\n      {/* Skills and Languages */}\n      <div id=\"skills-languages-grid\" className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n        {/* Skills */}\n        <div id=\"skills-subcard\" className=\"bg-white border border-slate-100 rounded-2xl p-6 shadow-xs space-y-4\">\n          <h2 id=\"skills-form-header\" className=\"text-slate-800 font-display font-semibold text-lg flex items-center gap-2 border-b border-slate-50 pb-3\">\n            <Code className=\"w-5 h-5 text-emerald-600\" />\n            Compet\303\252ncias & Ferramentas\n          </h2>\n          <form onSubmit={handleAddSkill} className=\"flex gap-2\">\n            <input\n              type=\"text\"\n              value={newSkill}\n              onChange={(e) => setNewSkill(e.target.value)}\n              placeholder=\"Adicionar compet\303\252ncia (ex: SQL, Excel)...\"\n              className=\"flex-1 text-xs px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-1 focus:ring-emerald-500 focus:border-emerald-500\"\n            />\n            <button\n              type=\"submit\"\n              className=\"px-3 py-2 bg-slate-800 hover:bg-slate-900 text-white rounded-lg text-xs font-medium transition\"\n            >\n              Adicionar\n            </button>\n          </form>\n          <div className=\"flex flex-wrap gap-1.5 pt-2\">\n            {cvData.skills.map((skill) => (\n              <span\n                key={skill}\n                className=\"inline-flex items-center gap-1 text-xs px-2.5 py-1 bg-emerald-50 text-emerald-800 rounded-lg border border-emerald-100/50\"\n              >\n                {skill}\n                <button\n                  type=\"button\"\n                  onClick={() => handleRemoveSkill(skill)}\n                  className=\"text-emerald-600 hover:text-emerald-900 font-bold ml-0.5\"\n                >\n                  &times;\n                </button>\n              </span>\n            ))}\n            {cvData.skills.length === 0 && (\n              <p className=\"text-slate-400 text-xs py-2\">Sem qualifica\303\247\303\265es adicionadas de momento.</p>\n            )}\n          </div>\n        </div>\n\n        {/* Languages */}\n        <div id=\"languages-subcard\" className=\"bg-white border border-slate-100 rounded-2xl p-6 shadow-xs space-y-4\">\n          <h2 id=\"languages-form-header\" className=\"text-slate-800 font-display font-semibold text-lg flex items-center gap-2 border-b border-slate-50 pb-3\">\n            <Languages className=\"w-5 h-5 text-emerald-600\" />\n            Idiomas\n          </h2>\n          <form onSubmit={handleAddLanguage} className=\"flex gap-2\">\n            <input\n              type=\"text\"\n              value={newLang}\n              onChange={(e) => setNewLang(e.target.value)}\n              placeholder=\"Adicionar l\303\255ngua (ex: Ingl\303\252s, Crioulo)...\"\n              className=\"flex-1 text-xs px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-1 focus:ring-emerald-500 focus:border-emerald-500\"\n            />\n            <button\n              type=\"submit\"\n              className=\"px-3 py-2 bg-slate-800 hover:bg-slate-900 text-white rounded-lg text-xs font-medium transition\"\n            >\n              Adicionar\n            </button>\n          </form>\n          <div className=\"flex flex-wrap gap-1.5 pt-2\">\n            {cvData.languages.map((lang) => (\n              <span\n                key={lang}\n                className=\"inline-flex items-center gap-1 text-xs px-2.5 py-1 bg-teal-50 text-teal-800 rounded-lg border border-teal-100/50\"\n              >\n                {lang}\n                <button\n                  type=\"button\"\n                  onClick={() => handleRemoveLanguage(lang)}\n                  className=\"text-teal-600 hover:text-teal-900 font-bold ml-0.5\"\n                >\n                  &times;\n                </button>\n              </span>\n            ))}\n            {cvData.languages.length === 0 && (\n              <p className=\"text-slate-400 text-xs py-2\">Nenhum idioma adicionado.</p>\n            )}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n"
    }
