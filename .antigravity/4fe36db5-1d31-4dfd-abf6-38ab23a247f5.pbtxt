    instruction: "Clean presets and add optimized resume downloader in CVOptimizer"
    replacement_infos {
      original_chunk {
        target_content: "import React, { useState } from \"react\";\nimport { CVData, OptimizationResult } from \"../types\";\nimport { MOCK_JOB_DESCRIPTIONS } from \"../mockData\";\nimport { Sparkles, ArrowRight, Check, Copy, AlertTriangle, ChevronRight, RefreshCw, BarChart2, CheckCircle2, Bookmark } from \"lucide-react\";\n\ninterface CVOptimizerProps {\n  cvData: CVData;\n  onUpdateCV: (updatedData: CVData) => void;\n}\n\nexport default function CVOptimizer({ cvData, onUpdateCV }: CVOptimizerProps) {\n  const [jobDescription, setJobDescription] = useState(MOCK_JOB_DESCRIPTIONS[0].description);\n  const [selectedPresetId, setSelectedPresetId] = useState(0);\n  const [loading, setLoading] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n  const [results, setResults] = useState<OptimizationResult | null>(null);\n  const [copiedTextId, setCopiedTextId] = useState<string | null>(null);\n  const [optimizeForGupy, setOptimizeForGupy] = useState(false);\n  const [jobUrlOrTitle, setJobUrlOrTitle] = useState(\"\");\n\n  const handleSelectPreset = (index: number) => {\n    setSelectedPresetId(index);\n    setJobDescription(MOCK_JOB_DESCRIPTIONS[index].description);\n  };\n\n  const handleCopy = (text: string, id: string) => {\n    navigator.clipboard.writeText(text);\n    setCopiedTextId(id);\n    setTimeout(() => {\n      setCopiedTextId(null);\n    }, 2000);\n  };\n\n  const handleApplySummary = () => {\n    if (results && results.suggestedSummary) {\n      onUpdateCV({\n        ...cvData,\n        summary: results.suggestedSummary\n      });\n      alert(\"Seu resumo oficial no perfil foi atualizado com sucesso!\");\n    }\n  };"
        replacement_content: "import React, { useState } from \"react\";\nimport { CVData, OptimizationResult } from \"../types\";\nimport { Sparkles, ArrowRight, Check, Copy, AlertTriangle, ChevronRight, RefreshCw, BarChart2, CheckCircle2, Bookmark, Download } from \"lucide-react\";\n\ninterface CVOptimizerProps {\n  cvData: CVData;\n  onUpdateCV: (updatedData: CVData) => void;\n}\n\nexport default function CVOptimizer({ cvData, onUpdateCV }: CVOptimizerProps) {\n  const [jobDescription, setJobDescription] = useState(\"\");\n  const [loading, setLoading] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n  const [results, setResults] = useState<OptimizationResult | null>(null);\n  const [copiedTextId, setCopiedTextId] = useState<string | null>(null);\n  const [optimizeForGupy, setOptimizeForGupy] = useState(false);\n  const [jobUrlOrTitle, setJobUrlOrTitle] = useState(\"\");\n\n  const handleCopy = (text: string, id: string) => {\n    navigator.clipboard.writeText(text);\n    setCopiedTextId(id);\n    setTimeout(() => {\n      setCopiedTextId(null);\n    }, 2000);\n  };\n\n  const handleApplySummary = () => {\n    if (results && results.suggestedSummary) {\n      onUpdateCV({\n        ...cvData,\n        summary: results.suggestedSummary\n      });\n      alert(\"Seu resumo oficial no perfil foi atualizado com sucesso!\");\n    }\n  };\n\n  const handleDownloadOptimized = () => {\n    if (!results) return;\n    \n    const optSummary = results.suggestedSummary || cvData.summary;\n    \n    let md = `# CURR\303\215CULO ALTAMENTE OTIMIZADO ATS\\n`;\n    md += `## Candidato: ${cvData.fullName || \"Utilizador\"}\\n\\n`;\n    \n    if (cvData.email || cvData.phone || cvData.location || cvData.website) {\n      const contactInfo = [];\n      if (cvData.email) contactInfo.push(`**Email:** ${cvData.email}`);\n      if (cvData.phone) contactInfo.push(`**Telefone:** ${cvData.phone}`);\n      if (cvData.location) contactInfo.push(`**Localiza\303\247\303\243o:** ${cvData.location}`);\n      if (cvData.website) contactInfo.push(`**LinkedIn/Website:** ${cvData.website}`);\n      md += contactInfo.join(\"  |  \") + \"\\n\\n\";\n    }\n    \n    md += `---\\n\\n`;\n    md += `## PERFIL PROFISSIONAL (OTIMIZADO POR IA)\\n\\n${optSummary}\\n\\n`;\n    md += `---\\n\\n`;\n    \n    md += `## EXPERI\303\212NCIA PROFISSIONAL (ALINHADA ATS)\\n\\n`;\n    cvData.experience.forEach(exp => {\n      md += `### ${exp.role} \342\200\224 ${exp.company}\\n`;\n      md += `*${exp.startDate} \342\200\223 ${exp.endDate || \"Presente\"}*  |  *${exp.location || \"Cabo Verde\"}*\\n\\n`;\n      \n      const sugExp = results.suggestedExperiences?.find(se => se.experienceId === exp.id);\n      if (sugExp && sugExp.suggestedBulletPoints && sugExp.suggestedBulletPoints.length > 0) {\n        md += `**Resultados e Responsabilidades Otimizados (Estrat\303\251gia STAR):**\\n`;\n        sugExp.suggestedBulletPoints.forEach(bp => {\n          md += `- ${bp}\\n`;\n        });\n        if (sugExp.justification) {\n          md += `\\n*Justifica\303\247\303\243o Estrat\303\251ga: ${sugExp.justification}*\\n`;\n        }\n        md += `\\n`;\n      } else if (exp.description) {\n        md += `${exp.description}\\n\\n`;\n      }\n    });\n    \n    md += `---\\n\\n`;\n    \n    if (cvData.education && cvData.education.length > 0) {\n      md += `## EDUCA\303\207\303\203O & FORM\303\207\303\203O\\n\\n`;\n      cvData.education.forEach(edu => {\n        md += `### ${edu.degree} \342\200\224 ${edu.fieldOfStudy}\\n`;\n        md += `*${edu.school}*  |  *${edu.startDate} \342\200\223 ${edu.endDate || \"\"}*  |  *${edu.location || \"\"}*\\n\\n`;\n      });\n      md += `---\\n\\n`;\n    }\n    \n    const combinedSkills = [...cvData.skills];\n    if (results.recommendedSkillsToAdd) {\n      results.recommendedSkillsToAdd.forEach(sk => {\n        if (!combinedSkills.map(s => s.toLowerCase()).includes(sk.toLowerCase())) {\n          combinedSkills.push(sk);\n        }\n      });\n    }\n    \n    if (combinedSkills.length > 0) {\n      md += `## COMPET\303\212NCIAS & WORDMARKS CORE (ATS COMPAT\303\215VEL)\\n\\n`;\n      md += combinedSkills.map(s => `- ${s}`).join(\"\\n\") + \"\\n\\n\";\n    }\n    \n    if (cvData.languages && cvData.languages.length > 0) {\n      md += `## IDIOMAS\\n\\n`;\n      md += cvData.languages.map(l => `- ${l}`).join(\"\\n\") + \"\\n\\n\";\n    }\n    \n    md += `---\\n`;\n    md += `### RELAT\303\223RIO DO ALINHAMENTO ATS\\n`;\n    md += `* **Afinidade Estimada:** Inicial ${results.scoreBefore}%  => Potencial ${results.scoreAfter}%\\n`;\n    if (results.gupyCompatibilityScore) {\n      md += `* **Compatibilidade algoritmos Gupy:** ${results.gupyCompatibilityScore}%\\n`;\n    }\n    md += `* **Palavras-chave incorporadas:** ${results.missingKeywords.join(\", \") || \"Nenhuma em falta\"}\\n`;\n\n    const blob = new Blob([md], { type: \"text/markdown;charset=utf-8;\" });\n    const url = URL.createObjectURL(blob);\n    const link = document.createElement(\"a\");\n    link.setAttribute(\"href\", url);\n    const cleanName = (cvData.fullName || \"Curriculo_Otimizado\").toLowerCase().replace(/\\s+/g, \"_\");\n    link.setAttribute(\"download\", `${cleanName}_otimizado_vaga.md`);\n    link.style.visibility = \"hidden\";\n    document.body.appendChild(link);\n    link.click();\n    document.body.removeChild(link);\n    alert(\"Curr\303\255culo altamente otimizado por IA baixado com sucesso! Use-o nas suas candidaturas.\");\n  };"
      }
      num_matches: 1
    }
  }
}
