    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport React, { useState, useEffect } from \"react\";\nimport { CVData } from \"./types\";\nimport { DEV_MOCK_CV } from \"./mockData\";\nimport ResumeForm from \"./components/ResumeForm\";\nimport CVOptimizer from \"./components/CVOptimizer\";\nimport CoverLetter from \"./components/CoverLetter\";\nimport NetworkingGenerator from \"./components/NetworkingGenerator\";\nimport InterviewSimulator from \"./components/InterviewSimulator\";\nimport CompanyDossier from \"./components/CompanyDossier\";\n\nimport {\n  Sparkles,\n  FileText,\n  User,\n  Briefcase,\n  Compass,\n  Layers,\n  Send,\n  HelpCircle,\n  Globe,\n  ArrowRight,\n  CheckCircle2,\n  Bookmark,\n  ChevronDown,\n  Menu,\n  X,\n  Target,\n  FileCheck\n} from \"lucide-react\";\n\nexport default function App() {\n  const [cvData, setCvData] = useState<CVData>(DEV_MOCK_CV);\n  const [activeTab, setActiveTab] = useState<\"home\" | \"editor\" | \"optimize\" | \"letter\" | \"network\" | \"interview\" | \"dossier\">(\"home\");\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\n\n  // Load from local storage if available\n  useEffect(() => {\n    const cached = localStorage.getItem(\"preparacv_data\");\n    if (cached) {\n      try {\n        setCvData(JSON.parse(cached));\n      } catch (err) {\n        console.error(\"Erro ao retroceder cache local de dados CV:\", err);\n      }\n    }\n  }, []);\n\n  const handleUpdateCV = (updated: CVData) => {\n    setCvData(updated);\n    localStorage.setItem(\"preparacv_data\", JSON.stringify(updated));\n  };\n\n  const navItems = [\n    { id: \"editor\", label: \"O Meu CV / Perfil\", icon: User },\n    { id: \"optimize\", label: \"Otimizador ATS\", icon: Target },\n    { id: \"letter\", label: \"Carta Estruturada\", icon: FileCheck },\n    { id: \"network\", label: \"Networking\", icon: Send },\n    { id: \"interview\", label: \"Simulador Entrevista\", icon: HelpCircle },\n    { id: \"dossier\", label: \"Dossi\303\252 Empresa\", icon: Globe },\n  ] as const;\n\n  return (\n    <div className=\"min-h-screen bg-[#fafbfc] text-slate-900 flex flex-col font-sans transition-all selection:bg-emerald-100 selection:text-emerald-950\">\n      \n      {/* Premium CV Header Navbar */}\n      <header className=\"sticky top-0 z-50 bg-white border-b border-slate-100 backdrop-blur-md bg-white/95\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-18 flex items-center justify-between\">\n          \n          {/* Logo Brand CV */}\n          <button\n            onClick={() => setActiveTab(\"home\")}\n            className=\"flex items-center gap-2.5 text-left group cursor-pointer focus:outline-none\"\n          >\n            <div className=\"w-10 h-10 rounded-xl bg-gradient-to-tr from-emerald-600 to-teal-500 flex items-center justify-center text-white font-display font-extrabold text-xl shadow-xs transition duration-300 group-hover:scale-105\">\n              P\n            </div>\n            <div>\n              <span className=\"font-display font-bold text-lg text-slate-900 tracking-tight block\">\n                Prepara<span className=\"text-emerald-600\">CV</span>\n              </span>\n              <span className=\"text-[10px] text-slate-400 font-mono tracking-widest block uppercase -mt-1 font-semibold\">\n                Cabo Verde AI\n              </span>\n            </div>\n          </button>\n\n          {/* Desktop Navigation */}\n          <nav className=\"hidden lg:flex items-center gap-1\">\n            {navItems.map((item) => {\n              const Icon = item.icon;\n              const isActive = activeTab === item.id;\n              return (\n                <button\n                  key={item.id}\n                  onClick={() => setActiveTab(item.id)}\n                  className={`px-3.5 py-2.5 rounded-xl text-xs font-semibold flex items-center gap-2 transition cursor-pointer ${\n                    isActive\n                      ? \"bg-slate-900 text-white shadow-xs\"\n                      : \"text-slate-600 hover:text-slate-900 hover:bg-slate-50\"\n                  }`}\n                >\n                  <Icon className={`w-4 h-4 ${isActive ? \"text-emerald-400\" : \"text-slate-400\"}`} />\n                  {item.label}\n                </button>\n              );\n            })}\n          </nav>\n\n          {/* User status & Actions */}\n          <div className=\"hidden lg:flex items-center gap-3\">\n            <div className=\"text-right\">\n              <span className=\"block text-xs font-semibold text-slate-800\">{cvData.fullName || \"Utilizador Prepara\"}</span>\n              <span className=\"text-[10px] text-emerald-650 bg-emerald-50 px-2 py-0.5 rounded-md font-medium\">CV Pronto a Alinhar</span>\n            </div>\n            <button\n              onClick={() => setActiveTab(\"editor\")}\n              title=\"visualizar perfil\"\n              className=\"w-9 h-9 rounded-full bg-slate-100 hover:bg-slate-200 flex items-center justify-center text-slate-600 border border-slate-200/50 cursor-pointer transition\"\n            >\n              <User className=\"w-4 h-4\" />\n            </button>\n          </div>\n\n          {/* Mobile hamburger menu */}\n          <button\n            onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n            className=\"lg:hidden p-2 text-slate-600 hover:text-slate-900 transition\"\n            title=\"toggle navigation menu\"\n          >\n            {mobileMenuOpen ? <X className=\"w-6 h-6\" /> : <Menu className=\"w-6 h-6\" />}\n          </button>\n        </div>\n\n        {/* Mobile menu panel */}\n        {mobileMenuOpen && (\n          <div className=\"lg:hidden bg-white border-b border-slate-100 p-4 space-y-2 animate-fade-in\">\n            {navItems.map((item) => {\n              const Icon = item.icon;\n              const isActive = activeTab === item.id;\n              return (\n                <button\n                  key={item.id}\n                  onClick={() => {\n                    setActiveTab(item.id);\n                    setMobileMenuOpen(false);\n                  }}\n                  className={`w-full text-left px-4 py-3 rounded-xl text-xs font-semibold flex items-center gap-2.5 transition ${\n                    isActive\n                      ? \"bg-slate-900 text-white\"\n                      : \"text-slate-700 hover:bg-slate-50\"\n                  }`}\n                >\n                  <Icon className={`w-4 h-4 ${isActive ? \"text-emerald-400\" : \"text-slate-400\"}`} />\n                  {item.label}\n                </button>\n              );\n            })}\n            <div className=\"border-t border-slate-50 pt-3 flex items-center justify-between px-2\">\n              <div className=\"text-left\">\n                <span className=\"block text-xs font-semibold text-slate-800\">{cvData.fullName || \"Utilizador Prepara\"}</span>\n                <span className=\"text-[9px] text-slate-400\">Cadastro An\303\263nimo Tempor\303\241rio</span>\n              </div>\n              <button\n                onClick={() => {\n                  setActiveTab(\"editor\");\n                  setMobileMenuOpen(false);\n                }}\n                className=\"text-xs text-emerald-600 font-semibold uppercase tracking-wider\"\n              >\n                Editar Perfil\n              </button>\n            </div>\n          </div>\n        )}\n      </header>\n\n      {/* Main Container Stage */}\n      <main className=\"flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-10\">\n        \n        {/* TAB 1: HOME PANEL */}\n        {activeTab === \"home\" && (\n          <div className=\"space-y-16 animate-fade-in\">\n            {/* Elegant Call-Out Hero Section */}\n            <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-center bg-radial from-[#ffffff] to-[#fafbfc]\">\n              <div className=\"lg:col-span-7 space-y-6 text-left\">\n                <div className=\"inline-flex items-center gap-2 bg-emerald-50 text-emerald-800 border border-emerald-100/60 px-3.5 py-1.5 rounded-full text-xs font-semibold\">\n                  <Sparkles className=\"w-4 h-4 text-emerald-650\" />\n                  Alcan\303\247e uma Taxa de Entrevistas de at\303\251 94%\n                </div>\n                \n                <h1 className=\"text-3xl sm:text-4xl lg:text-5xl font-display font-extrabold text-slate-900 leading-[1.125] tracking-tight\">\n                  Seu curr\303\255culo n\303\243o est\303\241 passando. <br />\n                  <span className=\"bg-gradient-to-r from-emerald-600 to-teal-600 bg-clip-text text-transparent\">A gente resolve isso.</span>\n                </h1>\n                \n                <p className=\"text-slate-500 text-sm md:text-base leading-relaxed max-w-xl\">\n                  Selecione, alinhe e otimize seu curr\303\255culo para cada vaga de trabalho individual em segundos. Alimente seus rascunhos de LinkedIn, treine com o simulador virtual de RH e conquiste a vaga dos seus sonhos em Cabo Verde e no exterior.\n                </p>\n\n                <div className=\"flex flex-col sm:flex-row gap-3 pt-2\">\n                  <button\n                    onClick={() => setActiveTab(\"optimize\")}\n                    className=\"px-6 py-3 bg-slate-900 hover:bg-slate-800 text-white font-medium text-xs rounded-xl shadow-md transition duration-200 flex items-center justify-center gap-2 cursor-pointer active:scale-95\"\n                  >\n                    Otimizar meu CV Agora\n                    <ArrowRight className=\"w-4 h-4 text-emerald-400\" />\n                  </button>\n                  <button\n                    onClick={() => setActiveTab(\"editor\")}\n                    className=\"px-6 py-3 bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 font-medium text-xs rounded-xl transition duration-200 flex items-center justify-center gap-2 cursor-pointer\"\n                  >\n                    Simular Cabo Verde Profiles\n                  </button>\n                </div>\n              </div>\n\n              {/* Graphic Mock card UI preview */}\n              <div className=\"lg:col-span-5 relative\">\n                <div className=\"absolute inset-0 bg-radial from-emerald-200/20 to-teal-200/25 blur-3xl opacity-60 rounded-full\" />\n                <div className=\"relative bg-white border border-slate-100 p-6 rounded-2xl shadow-sm space-y-4 max-w-sm mx-auto\">\n                  <div className=\"flex justify-between items-center bg-slate-50 p-3.5 rounded-xl border border-slate-100 mb-2\">\n                    <div className=\"flex items-center gap-2\">\n                      <div className=\"w-2.5 h-2.5 bg-rose-500 rounded-full animate-ping\" />\n                      <span className=\"text-[11px] font-bold text-slate-600 uppercase tracking-wider\">Afinidade de Vaga ATS</span>\n                    </div>\n                    <span className=\"text-sm font-extrabold text-rose-600\">42% (Abaixo do Ideal)</span>\n                  </div>\n\n                  <div className=\"space-y-2\">\n                    <h4 className=\"text-xs font-semibold text-slate-800\">Principais lacunas de compet\303\252ncias detectadas:</h4>\n                    <div className=\"flex flex-wrap gap-1\">\n                      {[\"Excel Avan\303\247ado\", \"Linguagem SQL\", \"Contabilidade\", \"Gest\303\243o de Equipes\"].map(term => (\n                        <span key={term} className=\"text-[10px] px-2 py-1 bg-rose-50 text-rose-850 rounded border border-rose-100 font-medium\">\n                          {term}\n                        </span>\n                      ))}\n                    </div>\n                  </div>\n\n                  <div className=\"bg-emerald-50/70 border border-emerald-100 p-4 rounded-xl space-y-1.5\">\n                    <span className=\"text-[10px] text-emerald-700 font-bold block uppercase tracking-wider\">Nova Vers\303\243o Orientada por STAR:</span>\n                    <p className=\"text-[11px] text-slate-700 leading-relaxed italic\">\n                      \"Utilizei Microsoft Excel Avan\303\247ado e linguagem SQL para cruzar bases de atendimento da CV Telecom, cortando o tempo m\303\251dio de resolu\303\247\303\243o em 15%...\"\n                    </p>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            {/* How It Works - Scraped Content replica */}\n            <div className=\"space-y-10 text-center\">\n              <div className=\"space-y-2\">\n                <span className=\"text-[10px] text-emerald-600 font-bold uppercase tracking-widest block font-mono\">Simplicidade Extrema</span>\n                <h2 className=\"text-2xl sm:text-3xl font-display font-extrabold text-slate-800\">Como funciona, em 4 passos</h2>\n                <p className=\"text-slate-400 text-xs max-w-sm mx-auto\">Constru\303\255do em torno de intelig\303\252ncia gerativa para que nenhuma candidatura termine no v\303\241cuo.</p>\n              </div>\n\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 text-left\">\n                {[\n                  {\n                    step: \"01\",\n                    title: \"Cole a Vaga de Trabalho\",\n                    desc: \"Indique o cargo que procura ou cole as exig\303\252ncias t\303\251cnicas que a empresa divulgou publicamente.\",\n                    color: \"border-slate-100 hover:border-emerald-200\"\n                  },\n                  {\n                    step: \"02\",\n                    title: \"M\303\263dulo IA Analisa\",\n                    desc: \"O motor do Google Gemini disseca o seu perfil contra a oportunidade, prevendo os \303\255ndices de classifica\303\247\303\243o ATS.\",\n                    color: \"border-slate-100 hover:border-teal-200\"\n                  },\n                  {\n                    step: \"03\",\n                    title: \"Desbloqueie o Kit Completo\",\n                    desc: \"Receba de imediato as novas reda\303\247\303\265es baseadas em conquistas quantitativas, roteiro de LinkedIn e carta formal.\",\n                    color: \"border-slate-100 hover:border-blue-200\"\n                  },\n                  {\n                    step: \"04\",\n                    title: \"Candidate-se com Confian\303\247a\",\n                    desc: \"Treine no simulador de perguntas de RH antes do telefonema real da empresa e conquiste aprova\303\247\303\265es.\",\n                    color: \"border-slate-100 hover:border-emerald-200\"\n                  }\n                ].map((item, idx) => (\n                  <div key={idx} className={`bg-white border rounded-2xl p-6 transition duration-200 shadow-2xs space-y-4 ${item.color}`}>\n                    <span className=\"text-3xl font-display font-extrabold text-emerald-100 block\">{item.step}</span>\n                    <h3 className=\"font-display font-bold text-slate-800 text-sm\">{item.title}</h3>\n                    <p className=\"text-slate-500 text-xs leading-relaxed\">{item.desc}</p>\n                  </div>\n                ))}\n              </div>\n            </div>\n\n            {/* Feature lists deck */}\n            <div className=\"bg-slate-900 text-white rounded-3xl p-8 md:p-12 grid grid-cols-1 lg:grid-cols-2 gap-8 items-center\">\n              <div className=\"space-y-6 text-left\">\n                <span className=\"text-[10px] text-emerald-400 font-bold uppercase tracking-widest font-mono\">Kit de Ferramentas Tudo em Um</span>\n                <h2 className=\"text-2xl sm:text-3xl font-display font-extrabold leading-tight\">Tudo Para Avan\303\247ar na Sua Candidatura</h2>\n                <p className=\"text-slate-300 text-xs md:text-sm leading-relaxed\">\n                  Criamos um ecossistema com profundidade que vai muito al\303\251m de um simples criador de PDF. Com o PreparaCV tem tudo para a sua carreira.\n                </p>\n\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs font-medium\">\n                  {[\n                    \"Networking Inteligente com Recrutador\",\n                    \"Ajuste Fino de Marcadores Individuais\",\n                    \"Carta de Recomenda\303\247\303\243o Acad\303\251mica\",\n                    \"Simulador de Recursos Humanos Interativo\",\n                    \"Intelig\303\252ncia Geopol\303\255tica com Dossi\303\252s\",\n                    \"Importa\303\247\303\243o de Perfis Exemplares de Cabo Verde\",\n                    \"F\303\263rmula ATS validada por especialistas\"\n                  ].map((feat, i) => (\n                    <div key={i} className=\"flex items-center gap-2\">\n                      <CheckCircle2 className=\"w-4 h-4 text-emerald-400 shrink-0\" />\n                      <span>{feat}</span>\n                    </div>\n                  ))}\n                </div>\n              </div>\n\n              <div className=\"bg-white/5 border border-white/10 rounded-2xl p-6 text-left space-y-4\">\n                <span className=\"text-[11px] text-emerald-300 uppercase tracking-widest font-bold\">Inicie agora mesmo</span>\n                <h4 className=\"font-display font-bold text-sm text-white\">Pronto para transformar sua carreira em Cabo Verde?</h4>\n                <p className=\"text-slate-300 text-xs leading-relaxed\">\n                  Importe seu perfil base a partir de predefini\303\247\303\265es e comece os alinhamentos a qualquer vaga. Todo o rascunho \303\251 persistido de forma an\303\263nima no seu navegador no total respeito pela privacidade.\n                </p>\n                <div className=\"pt-2\">\n                  <button\n                    onClick={() => setActiveTab(\"editor\")}\n                    className=\"px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs rounded-xl shadow-xs transition\"\n                  >\n                    Aceder ao Meu Perfil\n                  </button>\n                </div>\n              </div>\n            </div>\n          </div>\n        )}\n\n        {/* TAB 2: PROFILE EDITOR */}\n        {activeTab === \"editor\" && (\n          <div className=\"space-y-6\">\n            <div className=\"text-left\">\n              <h1 className=\"text-2xl font-display font-extrabold text-slate-900\">Configura\303\247\303\243o de Perfil / Curr\303\255culo</h1>\n              <p className=\"text-slate-500 text-xs mt-1\">Preencha as suas informa\303\247\303\265es pessoais, experi\303\252ncias escolares e fun\303\247\303\265es executadas. Seus dados s\303\243o salvos localmente e usados pela Intelig\303\252ncia Artificial para gerar os materiais profissionais no menu superior.</p>\n            </div>\n            <ResumeForm cvData={cvData} onChange={handleUpdateCV} />\n          </div>\n        )}\n\n        {/* TAB 3: ATS OPTIMIZER */}\n        {activeTab === \"optimize\" && (\n          <div className=\"space-y-6\">\n            <div className=\"text-left\">\n              <h1 className=\"text-2xl font-display font-extrabold text-slate-900\">Alinhamento de Curr\303\255culo & Otimiza\303\247\303\243o ATS</h1>\n              <p className=\"text-slate-500 text-xs mt-1\">Insira os termos da oportunidade e a IA vai reconfigurar os seus bullets da carreira e analisar seu posicionamento estrat\303\251gico, gerando palavras-chave para passar nos sistemas de RH.</p>\n            </div>\n            <CVOptimizer cvData={cvData} onUpdateCV={handleUpdateCV} />\n          </div>\n        )}\n\n        {/* TAB 4: COVER LETTER GENERAL */}\n        {activeTab === \"letter\" && (\n          <div className=\"space-y-6\">\n            <div className=\"text-left\">\n              <h1 className=\"text-2xl font-display font-extrabold text-slate-900\">Carta de Apresenta\303\247\303\243o Estruturada</h1>\n              <p className=\"text-slate-500 text-xs mt-1\">Obtenha rascunhos executivos polidos para as candidaturas por email e de candidatura espont\303\242nea a partir do seu hist\303\263rico de compet\303\252ncias profissionais.</p>\n            </div>\n            <CoverLetter cvData={cvData} />\n          </div>\n        )}\n\n        {/* TAB 5: NETWORKING MESSAGE GENERATION */}\n        {activeTab === \"network\" && (\n          <div className=\"space-y-6\">\n            <div className=\"text-left\">\n              <h1 className=\"text-2xl font-display font-extrabold text-slate-900\">Networking Inteligente & Ativo</h1>\n              <p className=\"text-slate-500 text-xs mt-1\">Selecione o cargo e a empresa e gere mensagens r\303\241pidas para enviar por LinkedIn ou Email Corporativo para demonstrar proatividade diretamente aos gerentes de RH.</p>\n            </div>\n            <NetworkingGenerator currentRole={cvData.experience[0]?.role || \"\"} />\n          </div>\n        )}\n\n        {/* TAB 6: CHAT / INTERVIEW RESUME PRACTICE SIMULATOR */}\n        {activeTab === \"interview\" && (\n          <div className=\"space-y-6\">\n            <div className=\"text-left\">\n              <h1 className=\"text-2xl font-display font-extrabold text-slate-900\">Simulador de Entrevista Pro</h1>\n              <p className=\"text-slate-500 text-xs mt-1\">Simule o processo de admiss\303\243o com o entrevistador inteligente. Redija resumos das suas atribui\303\247\303\265es, receba notas detalhadas de 0 a 100 e saiba o que responder com rascunhos de alta qualidade.</p>\n            </div>\n            <InterviewSimulator\n              jobTitle={cvData.experience[0]?.role || \"Programador Frontend / Assistente Administrativo\"}\n              jobDescription={cvData.summary}\n            />\n          </div>\n        )}\n\n        {/* TAB 7: COMPANY DOSSIER SYSTEM */}\n        {activeTab === \"dossier\" && (\n          <div className=\"space-y-6\">\n            <div className=\"text-left\">\n              <h1 className=\"text-2xl font-display font-extrabold text-slate-900\">Base de Informa\303\247\303\243o de Empresas (Grounding-Search)</h1>\n              <p className=\"text-slate-500 text-xs mt-1\">Pesquise por qualquer organiza\303\247\303\243o activa em Cabo Verde ou no estrangeiro e obtenha detalhes cruciais sobre as opera\303\247\303\265es institucionais da empresa e como se destacar na entrevista de admiss\303\243o.</p>\n            </div>\n            <CompanyDossier currentRole={cvData.experience[0]?.role || \"\"} />\n          </div>\n        )}\n\n      </main>\n\n      {/* Modern CV Portal Footer layout */}\n      <footer className=\"bg-slate-900 text-slate-400 text-xs border-t border-slate-800 py-10 mt-16 text-center\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6\">\n          <div className=\"flex flex-col md:flex-row justify-between items-center gap-4\">\n            \n            {/* Logo Brand Footer */}\n            <div className=\"flex items-center gap-2 group cursor-pointer text-left\">\n              <div className=\"w-8 h-8 rounded-lg bg-emerald-600 flex items-center justify-center text-white font-display font-extrabold text-base\">\n                P\n              </div>\n              <div>\n                <span className=\"font-display font-bold text-sm text-white tracking-tight block\">\n                  Prepara<span className=\"text-emerald-500\">CV</span>\n                </span>\n                <span className=\"text-[8px] text-slate-400 font-mono tracking-widest block uppercase -mt-0.5\">\n                  Cabo Verde AI\n                </span>\n              </div>\n            </div>\n\n            {/* Quick footer navigation links */}\n            <div className=\"flex flex-wrap justify-center gap-6 text-[11px] font-medium text-slate-400\">\n              <button onClick={() => setActiveTab(\"home\")} className=\"hover:text-white transition\">Home</button>\n              <button onClick={() => setActiveTab(\"editor\")} className=\"hover:text-white transition\">Meu CV</button>\n              <button onClick={() => setActiveTab(\"optimize\")} className=\"hover:text-white transition\">Otimiza\303\247\303\243o ATS</button>\n              <button onClick={() => setActiveTab(\"interview\")} className=\"hover:text-white transition\">Simulador</button>\n              <button onClick={() => setActiveTab(\"dossier\")} className=\"hover:text-white transition\">Dossi\303\252 Empresa</button>\n            </div>\n          </div>\n\n          <p className=\"text-slate-500 border-t border-slate-850 pt-5 leading-relaxed text-[11px] text-center max-w-sm mx-auto\">\n            \302\251 {new Date().getFullYear()} PreparaCV. Desenvolvido para o mercado profissional de Cabo Verde no total respeito da transpar\303\252ncia de IA algor\303\255tmica.\n          </p>\n        </div>\n      </footer>\n\n    </div>\n  );\n}\n"
    }
