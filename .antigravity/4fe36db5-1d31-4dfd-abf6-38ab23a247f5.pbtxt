 border border-slate-200 rounded-lg bg-white\"\n                      />\n                    </div>\n                  </div>\n                  <div>\n                    <label className=\"block text-xs font-medium text-slate-500 mb-0.5\">Localiza\303\247\303\243o</label>\n                    <input\n                      type=\"text\"\n                      value={exp.location}\n                      onChange={(e) => handleUpdateExperience(exp.id, \"location\", e.target.value)}\n                      placeholder=\"ex: Praia, Santiago\"\n                      className=\"w-full text-xs px-3 py-1.5 border border-slate-200 rounded-lg bg-white\"\n                    />\n                  </div>\n                  <div className=\"md:col-span-2\">\n                    <label className=\"block text-xs font-medium text-slate-500 mb-0.5\">Descri\303\247\303\243o de Atribui\303\247\303\265es e Conquistas</label>\n                    <textarea\n                      rows={3}\n                      value={exp.description}\n                      onChange={(e) => handleUpdateExperience(exp.id, \"description\", e.target.value)}\n                      placeholder=\"Detalhes sobre suas rotinas principais, projetos relevantes ou redu\303\247\303\265es de custos/erros que efetuou...\"\n                      className=\"w-full text-xs px-3 py-1.5 border border-slate-200 rounded-lg bg-white resize-none\"\n                    />\n                  </div>\n                </div>\n              </div>\n            ))}\n          </div>\n        )}\n      </div>"
