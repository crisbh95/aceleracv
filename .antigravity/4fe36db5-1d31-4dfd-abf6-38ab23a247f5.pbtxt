  file_change {
    absolute_path_uri: "file:///server.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport express from \"express\";\nimport path from \"path\";\nimport { createServer as createViteServer } from \"vite\";\nimport { GoogleGenAI, Type } from \"@google/genai\";\nimport dotenv from \"dotenv\";\n\ndotenv.config();\n\nconst app = express();\napp.use(express.json());\n\nconst PORT = 3000;\n\n// Lazy-initialized Gemini Client\nlet aiClient: GoogleGenAI | null = null;\n\nfunction getGeminiAI(): GoogleGenAI {\n  if (!aiClient) {\n    const key = process.env.GEMINI_API_KEY;\n    if (!key) {\n      throw new Error(\"GEMINI_API_KEY is not defined in the environment variables\");\n    }\n    aiClient = new GoogleGenAI({\n      apiKey: key,\n      httpOptions: {\n        headers: {\n          \'User-Agent\': \'aistudio-build\',\n        }\n      }\n    });\n  }\n  return aiClient;\n}\n\n// Middleware to check API key\nconst checkApiKey = (req: express.Request, res: express.Response, next: express.NextFunction) => {\n  try {\n    getGeminiAI();\n    next();\n  } catch (error) {\n    console.error(\"Gemini API key missing:\", error);\n    res.status(500).json({\n      error: \"API_KEY_MISSING\",\n      message: \"A chave API do Gemini n\303\243o foi encontrada. Por favor, adicione GEMINI_API_KEY nos Secrets no menu Settings do AI Studio.\"\n    });\n  }\n};\n\n// API: Health Check\napp.get(\"/api/health\", (req, res) => {\n  res.json({ status: \"ok\", time: new Date().toISOString() });\n});\n\n// API: Optimize CV to Job Description\napp.post(\"/api/optimize-cv\", checkApiKey, async (req, res) => {\n  try {\n    const { cvData, jobDescription } = req.body;\n    if (!cvData || !jobDescription) {\n      res.status(400).json({ error: \"Par\303\242metros inv\303\241lidos: cvData e jobDescription s\303\243o obrigat\303\263rios\" });\n      return;\n    }\n\n    const ai = getGeminiAI();\n    const prompt = `\n      Voc\303\252 \303\251 um Coach de Carreira especialista em ATS (Applicant Tracking Systems) e recrutamento profissional no mercado lus\303\263fono (incluindo Cabo Verde, Portugal e Brasil).\n      Analise o Curr\303\255culo fornecido e alinhe-o com a Vaga de Emprego especificada.\n\n      Curr\303\255culo:\n      ${JSON.stringify(cvData, null, 2)}\n\n      Vaga de Emprego:\n      ${jobDescription}\n\n      Objetivos principais:\n      1. Calcule a afinidade atual (scoreBefore de 0 a 100) e a projetada se as altera\303\247\303\265es forem feitas (scoreAfter, idealmente de 85 a 100).\n      2. Identifique palavras-chave cruciais da vaga que est\303\243o ausentes no curr\303\255culo inicial (missingKeywords).\n      3. Sugira uma nova descri\303\247\303\243o de Perfil Profissional / Resumo (suggestedSummary) ultra-alinhada \303\240 vaga, mantendo a verdade sobre a experi\303\252ncia do candidato.\n      4. Para cada experi\303\252ncia de trabalho listada, sugira de 2 a 3 bullet points altamente impactantes baseados no m\303\251todo Estrela (Situa\303\247\303\243o, Tarefa, A\303\247\303\243o, Resultado) com palavras de a\303\247\303\243o fortes e mencione por que isso ajuda (justification).\n      5. Liste pontos fortes do perfil candidato (strengthPoints).\n      6. Liste compet\303\252ncias recomendadas para adicionar na se\303\247\303\243o de habilidades (recommendedSkillsToAdd).\n\n      Gere a sua resposta em Portugu\303\252s estrito no formato de JSON que obede\303\247a ao esquema fornecido.\n    `;\n\n    const response = await ai.models.generateContent({\n      model: \"gemini-3.5-flash\",\n      contents: prompt,\n      config: {\n        responseMimeType: \"application/json\",\n        responseSchema: {\n          type: Type.OBJECT,\n          required: [\"scoreBefore\", \"scoreAfter\", \"missingKeywords\", \"suggestedSummary\", \"suggestedExperiences\", \"strengthPoints\", \"recommendedSkillsToAdd\"],\n          properties: {\n            scoreBefore: { type: Type.INTEGER, description: \"ATS score estimate out of 100 before changes\" },\n            scoreAfter: { type: Type.INTEGER, description: \"ATS score estimate out of 100 after changes\" },\n            missingKeywords: {\n              type: Type.ARRAY,\n              items: { type: Type.STRING },\n              description: \"High impact keywords present in the JD but missing from the resume\"\n            },\n            suggestedSummary: { type: Type.STRING, description: \"A tailored professional profile summary in Portuguese\" },\n            suggestedExperiences: {\n              type: Type.ARRAY,\n              items: {\n                type: Type.OBJECT,\n                required: [\"experienceId\", \"suggestedBulletPoints\", \"justification\"],\n                properties: {\n                  experienceId: { type: Type.STRING, description: \"The ID of the experience\" },\n                  suggestedBulletPoints: {\n                    type: Type.ARRAY,\n                    items: { type: Type.STRING },\n                    description: \"Tailored bullet points for this work experience\"\n                  },\n                  justification: { type: Type.STRING, description: \"Why these changes align well with the job\" }\n                }\n              }\n            },\n            strengthPoints: {\n              type: Type.ARRAY,\n              items: { type: Type.STRING },\n              description: \"Strengths identified in the candidate\'s history relative to the job\"\n            },\n            recommendedSkillsToAdd: {\n              type: Type.ARRAY,\n              items: { type: Type.STRING },\n              description: \"Habilidades, ferramentas ou metodologias sugeridas para incluir\"\n            }\n          }\n        }\n      }\n    });\n\n    const result = JSON.parse(response.text || \"{}\");\n    res.json(result);\n  } catch (error: any) {\n    console.error(\"Erro no optimize-cv:\", error);\n    res.status(500).json({ error: \"INTERNAL_SERVER_ERROR\", message: error.message || \"Erro desconhecido\" });\n  }\n});\n\n// API: Generate Cover Letter\napp.post(\"/api/generate-cover-letter\", checkApiKey, async (req, res) => {\n  try {\n    const { cvData, jobDescription, tone } = req.body;\n    if (!cvData || !jobDescription) {\n      res.status(400).json({ error: \"Par\303\242metros inv\303\241lidos: cvData e jobDescription s\303\243o obrigat\303\263rios\" });\n      return;\n    }\n\n    const ai = getGeminiAI();\n    const prompt = `\n      Crie uma carta de apresenta\303\247\303\243o elegante, persuasiva e customizada em Portugu\303\252s para esta candidatura.\n      Use o tom especificado: \"${tone || \"Profissional e entusiasmado\"}\".\n\n      Dados do Candidato:\n      Nome: ${cvData.fullName}\n      Localiza\303\247\303\243o: ${cvData.location}\n      Resumo: ${cvData.summary}\n      Principais experi\303\252ncias: ${JSON.stringify(cvData.experience.slice(0, 3))}\n\n      Vaga de Emprego:\n      ${jobDescription}\n\n      Estrutura esperada:\n      - Cabe\303\247alho formal (se aplic\303\241vel)\n      - Sauda\303\247\303\243o amig\303\241vel e profissional\n      - Par\303\241grafo de gancho: Mencione o papel desejado e expresse grande entusiasmo\n      - Corpo da carta (1 ou 2 par\303\241grafos): Conecte as principais conquistas do candidato aos desafios detalhados na vaga\n      - Par\303\241grafo final: Convite \303\240 entrevista e fechamento cort\303\252s.\n\n      Gere a sua resposta em Portugu\303\252s, estruturada em JSON obedecendo ao seguinte formato de esquema.\n    `;\n\n    const response = await ai.models.generateContent({\n      model: \"gemini-3.5-flash\",\n      contents: prompt,\n      config: {\n        responseMimeType: \"application/json\",\n        responseSchema: {\n          type: Type.OBJECT,\n          required: [\"letterText\", \"sectionsAdvice\"],\n          properties: {\n            letterText: { type: Type.STRING, description: \"The full text of the cover letter with newlines\" },\n            sectionsAdvice: {\n              type: Type.OBJECT,\n              required: [\"greeting\", \"hook\", \"body\", \"closure\"],\n              properties: {\n                greeting: { type: Type.STRING, description: \"Conselhos sobre a sauda\303\247\303\243o\" },\n                hook: { type: Type.STRING, description: \"Conselhos sobre o par\303\241grafo inicial\" },\n                body: { type: Type.STRING, description: \"Conselhos estruturais para o corpo\" },\n                closure: { type: Type.STRING, description: \"Conselhos para o encerramento\" }\n              }\n            }\n          }\n        }\n      }\n    });\n\n    const result = JSON.parse(response.text || \"{}\");\n    res.json(result);\n  } catch (error: any) {\n    console.error(\"Erro no generate-cover-letter:\", error);\n    res.status(500).json({ error: \"INTERNAL_SERVER_ERROR\", message: error.message });\n  }\n});\n\n// API: Generate Networking Messages (e.g. LinkedIn / Cold Email)\napp.post(\"/api/generate-networking\", checkApiKey, async (req, res) => {\n  try {\n    const { company, role, jobDescription } = req.body;\n    if (!company || !role) {\n      res.status(400).json({ error: \"Par\303\242metros inv\303\241lidos: company e role s\303\243o obrigat\303\263rios\" });\n      return;\n    }\n\n    const ai = getGeminiAI();\n    const prompt = `\n      Voc\303\252 \303\251 especialista em networking empresarial e recoloca\303\247\303\243o.\n      Gere 2 modelos de mensagens personalizadas em Portugu\303\252s para ajudar o candidato a fazer networking ativo:\n      1. Uma mensagem curta para contato direto via LinkedIn (m\303\241ximo de 300 caracteres).\n      2. Um e-mail formal e curto de abordagem para introdu\303\247\303\243o pessoal ou envio de candidatura espont\303\242nea.\n\n      Empresa: ${company}\n      Cargo: ${role}\n      ${jobDescription ? `Descri\303\247\303\243o da vaga: ${jobDescription}` : \"\"}\n\n      Instru\303\247\303\265es adicionais: Use tags como [Nome do Recrutador/Profissional] onde o usu\303\241rio deve customizar. Garanta que as mensagens sejam simp\303\241ticas, mostrem proatividade e busquem uma r\303\241pida conversa informativa de 10 minutos.\n\n      Escreva em Portugu\303\252s e responda no formato JSON estruturado estabelecido pelo esquema.\n    `;\n\n    const response = await ai.models.generateContent({\n      model: \"gemini-3.5-flash\",\n      contents: prompt,\n      config: {\n        responseMimeType: \"application/json\",\n        responseSchema: {\n          type: Type.OBJECT,\n          required: [\"templates\"],\n          properties: {\n            templates: {\n              type: Type.ARRAY,\n              items: {\n                type: Type.OBJECT,\n                required: [\"subject\", \"messageText\", \"channel\", \"coachingTip\"],\n                properties: {\n                  subject: { type: Type.STRING, description: \"Keep generic if LinkedIn, or write email subject line\" },\n                  messageText: { type: Type.STRING, description: \"The message template text\" },\n                  channel: { type: Type.STRING, description: \"\'LinkedIn\' or \'Email\'\" },\n                  coachingTip: { type: Type.STRING, description: \"Quick advice on how to use this template or find the contact person\" }\n                }\n              }\n            }\n          }\n        }\n      }\n    });\n\n    const result = JSON.parse(response.text || \"{}\");\n    res.json(result);\n  } catch (error: any) {\n    console.error(\"Erro no generate-networking:\", error);\n    res.status(500).json({ error: \"INTERNAL_SERVER_ERROR\", message: error.message });\n  }\n});\n\n// API: Interview Simulator - Generate customized questions\napp.post(\"/api/interview-simulator\", checkApiKey, async (req, res) => {\n  try {\n    const { jobTitle, jobDescription } = req.body;\n    if (!jobTitle) {\n      res.status(400).json({ error: \"Par\303\242metro inv\303\241lido: jobTitle \303\251 obrigat\303\263rio\" });\n      return;\n    }\n\n    const ai = getGeminiAI();\n    const prompt = `\n      Crie uma sess\303\243o de simulador de entrevista personalizada para o cargo de \"${jobTitle}\"\n      ${jobDescription ? `Com base na seguinte descri\303\247\303\243o de vaga: ${jobDescription}` : \"\"}\n\n      Seja um entrevistador realista de RH ou L\303\255der T\303\251cnico. Gere exatamente 5 perguntas diversificadas em Portugu\303\252s:\n      - 2 comportamentais (ex: \'Fale de um momento em que enfrentou um conflito...\')\n      - 2 t\303\251cnicas/espec\303\255ficas do cargo\n      - 1 situacional (ex: \'Imagine que temos um prazo de 2 dias e o servidor cai...\')\n\n      Para cada pergunta, identifique o \'intent\' (o que o entrevistador quer realmente testar ou ouvir do candidato) e d\303\252 \'tips\' pr\303\241ticas (conselhos r\303\241pidos de como estruturar a resposta, ex: usar m\303\251todo STAR).\n\n      Escreva em Portugu\303\252s no formato JSON estruturado por este esquema.\n    `;\n\n    const response = await ai.models.generateContent({\n      model: \"gemini-3.5-flash\",\n      contents: prompt,\n      config: {\n        responseMimeType: \"application/json\",\n        responseSchema: {\n          type: Type.OBJECT,\n          required: [\"jobTitle\", \"questions\"],\n          properties: {\n            jobTitle: { type: Type.STRING },\n            questions: {\n              type: Type.ARRAY,\n              items: {\n                type: Type.OBJECT,\n                required: [\"id\", \"questionText\", \"category\", \"intent\", \"tips\"],\n                properties: {\n                  id: { type: Type.STRING, description: \"Unique string ID for the question, e.g. q1, q2\" },\n                  questionText: { type: Type.STRING, description: \"The actual question asked\" },\n                  category: { type: Type.STRING, description: \"Must be: comportamental, tecnica, situacional, or geral\" },\n                  intent: { type: Type.STRING, description: \"Instru\303\247\303\243o impl\303\255cita do recrutador\" },\n                  tips: { type: Type.STRING, description: \"Conselhos de ouro para a resposta\" }\n                }\n              }\n            }\n          }\n        }\n      }\n    });\n\n    const result = JSON.parse(response.text || \"{}\");\n    res.json(result);\n  } catch (error: any) {\n    console.error(\"Erro no interview-simulator:\", error);\n    res.status(500).json({ error: \"INTERNAL_SERVER_ERROR\", message: error.message });\n  }\n});\n\n// API: Interview Evaluate - Evaluate simulated answer\napp.post(\"/api/interview-evaluate\", checkApiKey, async (req, res) => {\n  try {\n    const { questionText, userAnswer, jobTitle } = req.body;\n    if (!questionText || !userAnswer) {\n      res.status(400).json({ error: \"Par\303\242metros inv\303\241lidos: questionText e userAnswer s\303\243o obrigat\303\263rios\" });\n      return;\n    }\n\n    const ai = getGeminiAI();\n    const prompt = `\n      Voc\303\252 \303\251 um mentor de carreira s\303\252nior realizando uma simula\303\247\303\243o para o cargo de \"${jobTitle || \"Geral\"}\".\n      Avalie de forma extremamente emp\303\241tica, honesta e construtiva a resposta dada pelo candidato \303\240 pergunta do entrevistador.\n\n      Pergunta do Entrevistador:\n      \"${questionText}\"\n\n      Resposta do Candidato:\n      \"${userAnswer}\"\n\n      Objetivos:\n      1. Atribua um rating Geral: \"Excelente\", \"Bom\" ou \"Pode Melhorar\".\n      2. D\303\252 uma nota num\303\251rica de 0 a 100 baseada na clareza, relev\303\242ncia e estrutura.\n      3. Forne\303\247a pontos positivos identificados na fala (positives).\n      4. Forne\303\247a \303\241reas espec\303\255ficas de melhoria, como jarg\303\265es a evitar, falta de foco em resultados ou prolixidade (improvements).\n      5. Re-escreva a resposta do usu\303\241rio no formato ideal na primeira pessoa profissional de forma inspiradora (alternativeAnswer).\n\n      Gere a resposta em Portugu\303\252s estruturada no formato do esquema JSON.\n    `;\n\n    const response = await ai.models.generateContent({\n      model: \"gemini-3.5-flash\",\n      contents: prompt,\n      config: {\n        responseMimeType: \"application/json\",\n        responseSchema: {\n          type: Type.OBJECT,\n          required: [\"rating\", \"positives\", \"improvements\", \"alternativeAnswer\", \"score\"],\n          properties: {\n            rating: { type: Type.STRING, description: \"Must be: Excelente, Bom, or Pode Melhorar\" },\n            score: { type: Type.INTEGER, description: \"Overall score from 0 to 100\" },\n            positives: { type: Type.ARRAY, items: { type: Type.STRING }, description: \"O que o candidato fez muito bem na resposta\" },\n            improvements: { type: Type.ARRAY, items: { type: Type.STRING }, description: \"O que pode ser enriquecido ou polido\" },\n            alternativeAnswer: { type: Type.STRING, description: \"A highly polished, strong template version of their response in Portuguese\" }\n          }\n        }\n      }\n    });\n\n    const result = JSON.parse(response.text || \"{}\");\n    res.json(result);\n  } catch (error: any) {\n    console.error(\"Erro no interview-evaluate:\", error);\n    res.status(500).json({ error: \"INTERNAL_SERVER_ERROR\", message: error.message });\n  }\n});\n\n// API: Company Dossier (Uses Google Search Grounding to find real, up-to-date data!)\napp.post(\"/api/company-dossier\", checkApiKey, async (req, res) => {\n  try {\n    const { companyName, role } = req.body;\n    if (!companyName) {\n      res.status(400).json({ error: \"Par\303\242metro inv\303\241lido: companyName \303\251 obrigat\303\263rio\" });\n      return;\n    }\n\n    const ai = getGeminiAI();\n    const prompt = `\n      Crie um \"Dossi\303\252 Preparat\303\263rio\" de intelig\303\252ncia empresarial detalhado e atualizado sobre a empresa: \"${companyName}\".\n      O candidato est\303\241 pleiteando a vaga de: \"${role || \"Geral / Profissional\"}\".\n\n      Instru\303\247\303\265es para o modelo:\n      Use a pesquisa na web ativa (Google Search Grounding) para obter informa\303\247\303\265es atualizadas sobre as opera\303\247\303\265es, not\303\255cias recentes, produtos populares e miss\303\243o da empresa.\n      Foque em sintetizar de forma executiva e animadora:\n      - Ramo de atividade / Ind\303\272stria (industry)\n      - Descri\303\247\303\243o da Cultura e tom corporativo da empresa (cultureDescription)\n      - Principais produtos, servi\303\247os ou conquistas recentes (majorProductsServices)\n      - Not\303\255cias recentes, metas estrat\303\251gicas ou tend\303\252ncias em que eles est\303\243o focando (recentNewsOrTrends)\n      - Perguntas que provavelmente fariam na entrevista de emprego (likelyQuestionsAsked)\n      - Estrat\303\251gias t\303\241ticas de sucesso para o candidato impression\303\241-los na entrevista (interviewStrategy).\n\n      Escreva em Portugu\303\252s no formato estruturado especificado pelo esquema JSON.\n    `;\n\n    const response = await ai.models.generateContent({\n      model: \"gemini-3.5-flash\",\n      contents: prompt,\n      config: {\n        tools: [{ googleSearch: {} }],\n        // For compliance with schema output, we let the model output JSON and we specify format guidelines inside prompt.\n        // Wait, does googleSearch support responseSchema directly?\n        // Let\'s check: \"Do NOT set responseMimeType if googleMaps is used.\" But googleSearch is allowed with schemas.\n        // However, to be 100% safe with tools and json output compatibility, let\'s keep responseMimeType: \"application/json\" and supply responseSchema.\n        responseMimeType: \"application/json\",\n        responseSchema: {\n          type: Type.OBJECT,\n          required: [\"companyName\", \"industry\", \"cultureDescription\", \"majorProductsServices\", \"recentNewsOrTrends\", \"likelyQuestionsAsked\", \"interviewStrategy\"],\n          properties: {\n            companyName: { type: Type.STRING },\n            industry: { type: Type.STRING },\n            cultureDescription: { type: Type.STRING, description: \"Cultura organizacional\" },\n            majorProductsServices: { type: Type.ARRAY, items: { type: Type.STRING } },\n            recentNewsOrTrends: { type: Type.ARRAY, items: { type: Type.STRING } },\n            likelyQuestionsAsked: { type: Type.ARRAY, items: { type: Type.STRING } },\n            interviewStrategy: { type: Type.STRING, description: \"Dicas de ouro customizadas para impression\303\241-los\" }\n          }\n        }\n      }\n    });\n\n    const result = JSON.parse(response.text || \"{}\");\n    res.json(result);\n  } catch (error: any) {\n    console.error(\"Erro no company-dossier:\", error);\n    res.status(500).json({ error: \"INTERNAL_SERVER_ERROR\", message: error.message });\n  }\n});\n\n// Vite middleware development / Production statics integration\nconst startServer = async () => {\n  if (process.env.NODE_ENV !== \"production\") {\n    console.log(\"Starting server in DEVELOPMENT mode with Vite Middleware.\");\n    const vite = await createViteServer({\n      server: { middlewareMode: true },\n      appType: \"spa\",\n    });\n    app.use(vite.middlewares);\n  } else {\n    console.log(\"Starting server in PRODUCTION mode.\");\n    const distPath = path.join(process.cwd(), \"dist\");\n    app.use(express.static(distPath));\n    app.get(\"*\", (req, res) => {\n      res.sendFile(path.join(distPath, \"index.html\"));\n    });\n  }\n\n  app.listen(PORT, \"0.0.0.0\", () => {\n    console.log(`Server successfully listening on http://0.0.0.0:${PORT}`);\n  });\n};\n\nstartServer().catch((err) => {\n  console.error(\"Failed to start server:\", err);\n});\n"
    }
