    replacement_infos {
      original_chunk {
        target_content: "        <div className=\"bg-white border border-slate-100 rounded-2xl p-6 shadow-xs space-y-4\">\n          <h2 id=\"optimizer-input-title\" className=\"text-slate-800 font-display font-semibold text-lg flex items-center gap-2\">\n            <Bookmark className=\"w-5 h-5 text-emerald-600\" />\n            1. Carregar Detalhes da Vaga\n          </h2>\n          <p className=\"text-slate-500 text-xs\">\n            Selecione uma vaga de exemplo ou cole abaixo a vaga real que encontrou no LinkedIn, Netemprego ou no portal oficial da empresa.\n          </p>\n\n          {/* Job Presets */}\n          <div id=\"preset-buttons-group\" className=\"flex flex-col gap-2\">\n            {MOCK_JOB_DESCRIPTIONS.map((preset, idx) => (\n              <button\n                key={idx}\n                type=\"button\"\n                onClick={() => handleSelectPreset(idx)}\n                className={`text-left text-xs px-3.5 py-3 rounded-xl border transition-all flex items-start justify-between gap-2 ${\n                  selectedPresetId === idx\n                    ? \"bg-emerald-50/70 border-emerald-500 text-emerald-950 font-medium\"\n                    : \"bg-slate-50 border-slate-100 text-slate-700 hover:bg-slate-100/50\"\n                }`}\n              >\n                <div>\n                  <p className=\"font-semibold\">{preset.title}</p>\n                  <p className=\"text-[11px] text-slate-500 mt-0.5\">{preset.company}</p>\n                </div>\n                {selectedPresetId === idx && <CheckCircle2 className=\"w-4 h-4 text-emerald-600 shrink-0 mt-0.5\" />}\n              </button>\n            ))}\n          </div>\n\n          {/* Customized Paste Description */}\n          <div id=\"custom-paste-div\" className=\"space-y-1 pt-1\">\n            <label className=\"block text-xs font-semibold text-slate-700\">Descri\303\247\303\243o da Vaga de Trabalho / Requisitos</label>\n            <textarea\n              rows={8}\n              value={jobDescription}\n              onChange={(e) => {\n                setJobDescription(e.target.value);\n                setSelectedPresetId(-1); // Unset presets if manual edit\n              }}\n              placeholder=\"Cole aqui a descri\303\247\303\243o completa de atribui\303\247\303\265es e compet\303\252ncias requisitadas para a vaga...\"\n              className=\"w-full text-xs p-3 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition-all font-mono text-slate-700 resize-none\"\n            />\n          </div>"
        replacement_content: "        <div className=\"bg-white border border-slate-100 rounded-2xl p-6 shadow-xs space-y-4\">\n          <h2 id=\"optimizer-input-title\" className=\"text-slate-800 font-display font-semibold text-lg flex items-center gap-2\">\n            <Bookmark className=\"w-5 h-5 text-emerald-600\" />\n            1. Carregar Detalhes da Vaga Real\n          </h2>\n          <p className=\"text-slate-500 text-xs\">\n            Cole abaixo a vaga de trabalho real que voc\303\252 encontrou no LinkedIn, Gupy, Netemprego ou em outro portal de admiss\303\265es.\n          </p>\n\n          {/* Customized Paste Description */}\n          <div id=\"custom-paste-div\" className=\"space-y-1 pt-1\">\n            <label className=\"block text-xs font-semibold text-slate-700\">Descri\303\247\303\243o da Vaga de Trabalho / Requisitos</label>\n            <textarea\n              rows={11}\n              value={jobDescription}\n              onChange={(e) => {\n                setJobDescription(e.target.value);\n              }}\n              placeholder=\"Cole aqui as atribui\303\247\303\265es, requisitos t\303\251cnicos e compet\303\252ncias que a empresa divulgou para a vaga de emprego...\"\n              className=\"w-full text-xs p-3 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition-all font-mono text-slate-700 resize-none\"\n            />\n          </div>"
      }
      num_matches: 1
