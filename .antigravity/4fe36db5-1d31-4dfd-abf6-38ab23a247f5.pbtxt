        target_content: "            {/* Score Comparison Header */}\n            <div className=\"bg-white border border-slate-100 rounded-2xl p-6 shadow-xs\">\n              <h3 className=\"font-display font-semibold text-sm text-slate-500 tracking-wider uppercase mb-4\">Afinidade com a Vaga (ATS Score)</h3>\n              <div className=\"grid grid-cols-2 gap-4\">\n                <div className=\"bg-slate-50/80 rounded-xl p-4 text-center border border-slate-100\">\n                  <span className=\"text-[11px] text-slate-400 font-medium block uppercase tracking-wider\">Afinidade Inicial</span>\n                  <span className=\"text-3xl font-display font-extrabold text-slate-500 block mt-1\">{results.scoreBefore}%</span>\n                  <div className=\"w-full bg-slate-200 h-1.5 rounded-full mt-2.5 overflow-hidden\">\n                    <div className=\"bg-slate-400/80 h-1.5 rounded-full\" style={{ width: `${results.scoreBefore}%` }} />\n                  </div>\n                </div>\n\n                <div className=\"bg-emerald-50/40 rounded-xl p-4 text-center border border-emerald-100/60\">\n                  <span className=\"text-[11px] text-emerald-600 font-bold block uppercase tracking-wider flex items-center justify-center gap-1\">\n                    <Sparkles className=\"w-3 h-3 text-emerald-500\" /> Potencial com IA\n                  </span>\n                  <span className=\"text-3xl font-display font-extrabold text-emerald-700 block mt-1\">{results.scoreAfter}%</span>\n                  <div className=\"w-full bg-emerald-200 h-1.5 rounded-full mt-2.5 overflow-hidden\">\n                    <div className=\"bg-emerald-600 h-1.5 rounded-full\" style={{ width: `${results.scoreAfter}%` }} />\n                  </div>\n                </div>\n              </div>\n            </div>"
        replacement_content: "            {/* Score Comparison Header */}\n            <div className=\"bg-white border border-slate-100 rounded-2xl p-6 shadow-xs\">\n              <h3 className=\"font-display font-semibold text-sm text-slate-500 tracking-wider uppercase mb-4\">Afinidade com a Vaga (ATS Score)</h3>\n              <div className=\"grid grid-cols-2 gap-4\">\n                <div className=\"bg-slate-50/80 rounded-xl p-4 text-center border border-slate-100\">\n                  <span className=\"text-[11px] text-slate-400 font-medium block uppercase tracking-wider\">Afinidade Inicial</span>\n                  <span className=\"text-3xl font-display font-extrabold text-slate-500 block mt-1\">{results.scoreBefore}%</span>\n                  <div className=\"w-full bg-slate-200 h-1.5 rounded-full mt-2.5 overflow-hidden\">\n                    <div className=\"bg-slate-400/80 h-1.5 rounded-full\" style={{ width: `${results.scoreBefore}%` }} />\n                  </div>\n                </div>\n\n                <div className=\"bg-emerald-50/40 rounded-xl p-4 text-center border border-emerald-100/60\">\n                  <span className=\"text-[11px] text-emerald-600 font-bold block uppercase tracking-wider flex items-center justify-center gap-1\">\n                    <Sparkles className=\"w-3 h-3 text-emerald-500\" /> Potencial com IA\n                  </span>\n                  <span className=\"text-3xl font-display font-extrabold text-emerald-700 block mt-1\">{results.scoreAfter}%</span>\n                  <div className=\"w-full bg-emerald-200 h-1.5 rounded-full mt-2.5 overflow-hidden\">\n                    <div className=\"bg-emerald-600 h-1.5 rounded-full\" style={{ width: `${results.scoreAfter}%` }} />\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            {/* Download Optimized Resume Action Box */}\n            <div id=\"download-opt-banner\" className=\"bg-gradient-to-r from-emerald-600 to-teal-700 rounded-2xl p-6 text-white shadow-xs space-y-4 animate-fade-in flex flex-col md:flex-row justify-between items-start md:items-center gap-4 text-left\">\n              <div className=\"space-y-1\">\n                <span className=\"px-2 py-0.5 bg-white/20 text-white rounded text-[10px] font-extrabold font-mono tracking-wider uppercase\">EXPORTAR SELE\303\207\303\203O</span>\n                <h3 className=\"font-display font-bold text-base\">Descarregar Curr\303\255culo Alinhado por IA</h3>\n                <p className=\"text-white/80 text-xs max-w-md leading-relaxed\">\n                  Tudo pronto! Juntamos os seus dados pessoais com o novo Resumo Profissional sugerido e as novas realiza\303\247\303\265es formatadas no m\303\251todo STAR para a vaga.\n                </p>\n              </div>\n              <button\n                type=\"button\"\n                onClick={handleDownloadOptimized}\n                className=\"w-full md:w-auto px-5 py-3.5 bg-white hover:bg-slate-50 text-emerald-950 font-extrabold text-xs rounded-xl shadow-md transition duration-150 flex items-center justify-center gap-2 shrink-0 cursor-pointer active:scale-95 text-center\"\n              >\n                <Download className=\"w-4 h-4 text-emerald-600\" />\n                Baixar Curr\303\255culo Otimizado (.MD)\n              </button>\n            </div>"
