    instruction: "Add Drag and Drop Resume Upload + Markdown download to ResumeForm component"
    replacement_infos {
      original_chunk {
        target_content: "import React, { useState } from \"react\";\nimport { CVData, WorkExperience, Education } from \"../types\";\nimport { DEV_MOCK_CV, ADM_MOCK_CV } from \"../mockData\";\nimport { Plus, Trash2, Edit2, Check, User, Briefcase, GraduationCap, Code, Languages, FileText, Sparkles, RefreshCw } from \"lucide-react\";\n\ninterface ResumeFormProps {\n  cvData: CVData;\n  onChange: (data: CVData) => void;\n}\n\nexport default function ResumeForm({ cvData, onChange }: ResumeFormProps) {\n  const [newSkill, setNewSkill] = useState(\"\");\n  const [newLang, setNewLang] = useState(\"\");\n\n  const handlePersonalChange = (e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement>) => {\n    onChange({\n      ...cvData,\n      [e.target.name]: e.target.value\n    });\n  };\n\n  const handleImport = (type: \"dev\" | \"adm\") => {\n    if (type === \"dev\") {\n      onChange(DEV_MOCK_CV);\n    } else {\n      onChange(ADM_MOCK_CV);\n    }\n  };"
        replacement_content: "import React, { useState } from \"react\";\nimport { CVData, WorkExperience, Education } from \"../types\";\nimport { DEV_MOCK_CV, ADM_MOCK_CV } from \"../mockData\";\nimport { Plus, Trash2, Edit2, Check, User, Briefcase, GraduationCap, Code, Languages, FileText, Sparkles, RefreshCw, UploadCloud, Download, AlertCircle, Loader2 } from \"lucide-react\";\n\ninterface ResumeFormProps {\n  cvData: CVData;\n  onChange: (data: CVData) => void;\n}\n\nexport default function ResumeForm({ cvData, onChange }: ResumeFormProps) {\n  const [newSkill, setNewSkill] = useState(\"\");\n  const [newLang, setNewLang] = useState(\"\");\n\n  // File upload states\n  const [uploading, setUploading] = useState(false);\n  const [uploadError, setUploadError] = useState<string | null>(null);\n  const [dragActive, setDragActive] = useState(false);\n\n  // File drag & drop actions\n  const handleDrag = (e: React.DragEvent) => {\n    e.preventDefault();\n    e.stopPropagation();\n    if (e.type === \"dragenter\" || e.type === \"dragover\") {\n      setDragActive(true);\n    } else if (e.type === \"dragleave\") {\n      setDragActive(false);\n    }\n  };\n\n  const processFile = async (file: File) => {\n    setUploading(true);\n    setUploadError(null);\n    try {\n      // 1. Read file as base64 using FileReader\n      const base64Promise = new Promise<string>((resolve, reject) => {\n        const reader = new FileReader();\n        reader.onload = (event) => {\n          if (event.target && event.target.result) {\n            const dataUrl = event.target.result as string;\n            const base64Data = dataUrl.split(\",\")[1];\n            resolve(base64Data);\n          } else {\n            reject(new Error(\"Erro ao converter ficheiro para Base64\"));\n          }\n        };\n        reader.onerror = () => reject(new Error(\"Erro de leitura do ficheiro\"));\n        reader.readAsDataURL(file);\n      });\n\n      const fileBase64 = await base64Promise;\n\n      // 2. Call parse endpoint\n      const response = await fetch(\"/api/parse-cv-file\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({\n          fileBase64: fileBase64,\n          mimeType: file.type || \"application/pdf\",\n          fileName: file.name\n        })\n      });\n\n      const data = await response.json();\n      if (!response.ok) {\n        throw new Error(data.message || \"Erro de processamento no servidor.\");\n      }\n\n      if (data.error === \"API_KEY_MISSING\") {\n        throw new Error(\"A chave API do Gemini \303\251 necess\303\241ria nos Secrets (Settings) para realizar o preenchimento autom\303\241tico.\");\n      }\n\n      onChange(data);\n      alert(\"Sucesso! O seu curr\303\255culo foi lido e todos os campos foram preenchidos de forma autom\303\241tica!\");\n    } catch (err: any) {\n      console.error(\"Erro no processamento do ficheiro:\", err);\n      setUploadError(err.message || \"N\303\243o foi poss\303\255vel processar o curr\303\255culo.\");\n    } finally {\n      setUploading(false);\n    }\n  };\n\n  const handleDrop = (e: React.DragEvent) => {\n    e.preventDefault();\n    e.stopPropagation();\n    setDragActive(false);\n    if (e.dataTransfer.files && e.dataTransfer.files[0]) {\n      processFile(e.dataTransfer.files[0]);\n    }\n  };\n\n  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {\n    if (e.target.files && e.target.files[0]) {\n      processFile(e.target.files[0]);\n    }\n  };\n\n  // Convert CV to Markdown for downloading\n  const convertCVToMarkdown = (cv: CVData): string => {\n    let md = `# CURR\303\215CULO PROFISSIONAL: ${cv.fullName || \"Candidato\"}\\n\\n`;\n    if (cv.email || cv.phone || cv.location || cv.website) {\n      const contactInfo = [];\n      if (cv.email) contactInfo.push(`**Email:** ${cv.email}`);\n      if (cv.phone) contactInfo.push(`**Telefone:** ${cv.phone}`);\n      if (cv.location) contactInfo.push(`**Localiza\303\247\303\243o:** ${cv.location}`);\n      if (cv.website) contactInfo.push(`**LinkedIn/Website:** ${cv.website}`);\n      md += contactInfo.join(\"  |  \") + \"\\n\\n\";\n    }\n    \n    md += `---\\n\\n`;\n    \n    if (cv.summary) {\n      md += `## PERFIL PROFISSIONAL\\n\\n${cv.summary}\\n\\n`;\n      md += `---\\n\\n`;\n    }\n    \n    if (cv.experience && cv.experience.length > 0) {\n      md += `## EXPERI\303\212NCIA PROFISSIONAL\\n\\n`;\n      cv.experience.forEach(exp => {\n        md += `### ${exp.role} \342\200\224 ${exp.company}\\n`;\n        md += `*${exp.startDate} \342\200\223 ${exp.endDate || \"Presente\"}*  |  *${exp.location || \"Cabo Verde\"}*\\n\\n`;\n        if (exp.description) {\n          md += `${exp.description}\\n\\n`;\n        }\n      });\n      md += `---\\n\\n`;\n    }\n    \n    if (cv.education && cv.education.length > 0) {\n      md += `## EDUCA\303\207\303\203O & FORMA\303\207\303\203O\\n\\n`;\n      cv.education.forEach(edu => {\n        md += `### ${edu.degree} \342\200\224 ${edu.fieldOfStudy}\\n`;\n        md += `*${edu.school}*  |  *${edu.startDate} \342\200\223 ${edu.endDate || \"\"}*  |  *${edu.location || \"\"}*\\n\\n`;\n      });\n      md += `---\\n\\n`;\n    }\n    \n    if (cv.skills && cv.skills.length > 0) {\n      md += `## COMPET\303\212NCIAS & FERRAMENTAS\\n\\n`;\n      md += cv.skills.map(s => `- ${s}`).join(\"\\n\") + \"\\n\\n\";\n    }\n    \n    if (cv.languages && cv.languages.length > 0) {\n      md += `## IDIOMAS\\n\\n`;\n      md += cv.languages.map(l => `- ${l}`).join(\"\\n\") + \"\\n\\n\";\n    }\n    \n    return md;\n  };\n\n  const handleDownloadMarkdown = () => {\n    const mdContent = convertCVToMarkdown(cvData);\n    const blob = new Blob([mdContent], { type: \"text/markdown;charset=utf-8;\" });\n    const url = URL.createObjectURL(blob);\n    const link = document.createElement(\"a\");\n    link.setAttribute(\"href\", url);\n    const cleanName = (cvData.fullName || \"Curriculo_Otimizado\").toLowerCase().replace(/\\s+/g, \"_\");\n    link.setAttribute(\"download\", `${cleanName}_completo.md`);\n    link.style.visibility = \"hidden\";\n    document.body.appendChild(link);\n    link.click();\n    document.body.removeChild(link);\n  };\n\n  const handlePersonalChange = (e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement>) => {\n    onChange({\n      ...cvData,\n      [e.target.name]: e.target.value\n    });\n  };\n\n  const handleImport = (type: \"dev\" | \"adm\") => {\n    if (type === \"dev\") {\n      onChange(DEV_MOCK_CV);\n    } else {\n      onChange(ADM_MOCK_CV);\n    }\n  };"
      }
      num_matches: 1
    }
  }
}
