  file_change {
    absolute_path_uri: "file:///src/components/CoverLetter.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport React, { useState } from \"react\";\nimport { CVData, CoverLetterResult } from \"../types\";\nimport { Copy, Check, FileText, Sparkles, RefreshCw, AlertTriangle, Lightbulb } from \"lucide-react\";\n\ninterface CoverLetterProps {\n  cvData: CVData;\n}\n\nexport default function CoverLetter({ cvData }: CoverLetterProps) {\n  const [tone, setTone] = useState(\"Profissional e entusiasmado\");\n  const [jobDescription, setJobDescription] = useState(\"\");\n  const [loading, setLoading] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n  const [result, setResult] = useState<CoverLetterResult | null>(null);\n  const [copied, setCopied] = useState(false);\n\n  const TONES = [\n    \"Profissional e entusiasmado\",\n    \"Altamente formal e respeitoso\",\n    \"Criativo e inovador\",\n    \"Focado puramente em n\303\272meros e resultados\"\n  ];\n\n  const handleCopy = () => {\n    if (result) {\n      navigator.clipboard.writeText(result.letterText);\n      setCopied(true);\n      setTimeout(() => setCopied(false), 2000);\n    }\n  };\n\n  const executeDraft = async () => {\n    if (!jobDescription.trim()) {\n      setError(\"Por favor, cole os requisitos ou detalhes da vaga primeiro.\");\n      return;\n    }\n    setLoading(true);\n    setError(null);\n\n    try {\n      const response = await fetch(\"/api/generate-cover-letter\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({ cvData, jobDescription, tone })\n      });\n\n      const data = await response.json();\n      if (!response.ok) {\n        throw new Error(data.message || \"Erro de comunica\303\247\303\243o ao produzir rascunho.\");\n      }\n\n      setResult(data);\n    } catch (err: any) {\n      console.error(err);\n      setError(err.message || \"Um erro inesperado ocorreu. Certifique-se de que a API Key est\303\241 configurada.\");\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  return (\n    <div id=\"cover-letter-root\" className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 animate-fade-in text-slate-800\">\n      {/* Settings Side */}\n      <div id=\"letter-settings-panel\" className=\"lg:col-span-4 space-y-6\">\n        <div className=\"bg-white border border-slate-100 rounded-2xl p-6 shadow-xs space-y-4\">\n          <h2 className=\"text-slate-800 font-display font-semibold text-lg flex items-center gap-2\">\n            <FileText className=\"w-5 h-5 text-emerald-600\" />\n            Carta de Apresenta\303\247\303\243o\n          </h2>\n          <p className=\"text-slate-500 text-xs leading-relaxed\">\n            Escreva ou cole a proposta da vaga abaixo. O redator de IA gerar\303\241 uma carta sob medida, destacando elementos do seu hist\303\263rico oficial.\n          </p>\n\n          {/* Job Details Input */}\n          <div className=\"space-y-1\">\n            <label className=\"block text-xs font-medium text-slate-600\">Alvo da Vaga (Cole aqui ou use a anterior)</label>\n            <textarea\n              rows={6}\n              value={jobDescription}\n              onChange={(e) => setJobDescription(e.target.value)}\n              placeholder=\"Ex: Procuramos assistente administrativo com facilidade de comunica\303\247\303\243o ou desenvolvedor web responsivo...\"\n              className=\"w-full text-xs p-3 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition resize-none\"\n            />\n          </div>\n\n          {/* Tone Selector */}\n          <div className=\"space-y-2\">\n            <label className=\"block text-xs font-medium text-slate-600\">Tom da Carta</label>\n            <div className=\"grid grid-cols-1 gap-1.5ClassName\">\n              {TONES.map((t) => (\n                <button\n                  key={t}\n                  type=\"button\"\n                  onClick={() => setTone(t)}\n                  className={`text-left text-xs px-3 py-2.5 rounded-lg border transition ${\n                    tone === t\n                      ? \"bg-slate-800 border-slate-900 text-white font-medium\"\n                      : \"bg-slate-50 border-slate-100 text-slate-700 hover:bg-slate-100/50\"\n                  }`}\n                >\n                  {t}\n                </button>\n              ))}\n            </div>\n          </div>\n\n          <button\n            type=\"button\"\n            onClick={executeDraft}\n            disabled={loading}\n            className={`w-full py-2.5 px-4 rounded-xl font-medium text-xs flex items-center justify-center gap-2 transition duration-200 ${\n              loading\n                ? \"bg-slate-100 text-slate-400 cursor-not-allowed\"\n                : \"bg-emerald-600 hover:bg-emerald-700 text-white shadow-xs\"\n            }`}\n          >\n            {loading ? (\n              <>\n                <RefreshCw className=\"w-4 h-4 animate-spin\" />\n                Drafting Letter...\n              </>\n            ) : (\n              <>\n                <Sparkles className=\"w-4 h-4 text-emerald-300\" />\n                Redigir Carta sob Medida\n              </>\n            )}\n          </button>\n        </div>\n      </div>\n\n      {/* Result Section Card */}\n      <div id=\"letter-results-panel\" className=\"lg:col-span-8\">\n        {error && (\n          <div className=\"bg-rose-50 border border-rose-100 rounded-2xl p-5 text-rose-900 flex items-start gap-3.5 mb-6\">\n            <AlertTriangle className=\"w-5 h-5 text-rose-500 shrink-0 mt-0.5\" />\n            <div>\n              <h4 className=\"font-semibold text-sm\">N\303\243o foi poss\303\255vel criar a carta</h4>\n              <p className=\"text-xs text-rose-600 mt-0.5\">{error}</p>\n            </div>\n          </div>\n        )}\n\n        {!result && !loading && !error && (\n          <div className=\"h-full min-h-[420px] border-2 border-dashed border-slate-100 rounded-2xl p-8 flex flex-col items-center justify-center text-center bg-slate-50/30\">\n            <FileText className=\"w-12 h-12 text-slate-300 stroke-[1.5] mb-3\" />\n            <h3 className=\"font-display font-medium text-slate-700 text-base\">Papel de Carta Inteligente</h3>\n            <p className=\"text-slate-400 text-xs max-w-xs mt-1 leading-relaxed\">\n              Forne\303\247a os detalhes da vaga de destino \303\240 esquerda e clique em programar para redigir um rascunho de alto calibre estrutural.\n            </p>\n          </div>\n        )}\n\n        {loading && (\n          <div className=\"h-full min-h-[420px] bg-white border border-slate-100 rounded-2xl p-8 flex flex-col items-center justify-center text-center space-y-4\">\n            <div className=\"relative flex items-center justify-center\">\n              <div className=\"w-12 h-12 rounded-full border-4 border-emerald-200 border-t-emerald-600 animate-spin\" />\n              <FileText className=\"w-5 h-5 text-emerald-500 absolute animate-pulse\" />\n            </div>\n            <div>\n              <h3 className=\"font-display font-medium text-slate-800 text-base font-semibold\">Tecendo a Proposta...</h3>\n              <p className=\"text-slate-400 text-xs max-w-xs mt-1 leading-relaxed\">\n                Consultando suas compet\303\252ncias t\303\251cnicas e ligando-as com sensibilidade estrat\303\251gica aos desafios da empresa listada...\n              </p>\n            </div>\n          </div>\n        )}\n\n        {result && !loading && (\n          <div className=\"space-y-6\">\n            {/* Elegant Letter Sheet mockup */}\n            <div className=\"bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden animate-fade-in relative\">\n              {/* Header block decoration */}\n              <div className=\"bg-gradient-to-r from-slate-900 via-emerald-950 to-slate-900 px-6 py-4 flex justify-between items-center\">\n                <span className=\"text-xs font-display font-semibold tracking-wider text-emerald-300 uppercase\">PreparaCV - Carta Rascunho</span>\n                <button\n                  onClick={handleCopy}\n                  className=\"bg-white/10 hover:bg-white/20 text-white py-1 px-3.5 rounded-lg text-xs font-semibold select-none cursor-pointer transition flex items-center gap-1.5\"\n                >\n                  {copied ? (\n                    <>\n                      <Check className=\"w-3.5 h-3.5 text-emerald-400\" />\n                      Copiado!\n                    </>\n                  ) : (\n                    <>\n                      <Copy className=\"w-3.5 h-3.5\" />\n                      Copiar Carta\n                    </>\n                  )}\n                </button>\n              </div>\n\n              {/* The \"Paper\" container */}\n              <div className=\"p-8 md:p-10 text-slate-800 leading-relaxed text-sm bg-radial from-slate-50/50 to-white font-serif max-h-[600px] overflow-y-auto whitespace-pre-wrap whitespace-pre-line border-b border-slate-100\">\n                {result.letterText}\n              </div>\n\n              {/* Coach Advisory Accordion details */}\n              <div className=\"bg-slate-50/60 p-6 space-y-4 font-sans text-xs\">\n                <h4 className=\"font-display font-semibold text-slate-700 uppercase tracking-wider flex items-center gap-1.5\">\n                  <Lightbulb className=\"w-4 h-4 text-amber-500 shrink-0\" />\n                  Conselho Estrat\303\251gico do Coach de Carreira:\n                </h4>\n                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                  {result.sectionsAdvice.greeting && (\n                    <div className=\"bg-white border border-slate-100 p-3 rounded-xl\">\n                      <span className=\"font-semibold text-emerald-800 block mb-0.5\">Sauda\303\247\303\243o:</span>\n                      <span className=\"text-slate-600 leading-relaxed text-[11px]\">{result.sectionsAdvice.greeting}</span>\n                    </div>\n                  )}\n                  {result.sectionsAdvice.hook && (\n                    <div className=\"bg-white border border-slate-100 p-3 rounded-xl\">\n                      <span className=\"font-semibold text-emerald-800 block mb-0.5\">Sua Introdu\303\247\303\243o:</span>\n                      <span className=\"text-slate-600 leading-relaxed text-[11px]\">{result.sectionsAdvice.hook}</span>\n                    </div>\n                  )}\n                  {result.sectionsAdvice.body && (\n                    <div className=\"bg-white border border-slate-100 p-3 rounded-xl\">\n                      <span className=\"font-semibold text-emerald-800 block mb-0.5\">Corpo da Mensagem:</span>\n                      <span className=\"text-slate-600 leading-relaxed text-[11px]\">{result.sectionsAdvice.body}</span>\n                    </div>\n                  )}\n                  {result.sectionsAdvice.closure && (\n                    <div className=\"bg-white border border-slate-100 p-3 rounded-xl\">\n                      <span className=\"font-semibold text-emerald-800 block mb-0.5\">Encerramento:</span>\n                      <span className=\"text-slate-600 leading-relaxed text-[11px]\">{result.sectionsAdvice.closure}</span>\n                    </div>\n                  )}\n                </div>\n              </div>\n            </div>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n}\n"
    }
    diff {
      unified_diff {
