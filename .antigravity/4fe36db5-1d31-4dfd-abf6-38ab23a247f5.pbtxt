    replacement_infos {
      original_chunk {
        target_content: "// API: Optimize CV to Job Description\napp.post(\"/api/optimize-cv\", checkApiKey, async (req, res) => {\n  try {\n    const { cvData, jobDescription } = req.body;\n    if (!cvData || !jobDescription) {\n      res.status(400).json({ error: \"Par\303\242metros inv\303\241lidos: cvData e jobDescription s\303\243o obrigat\303\263rios\" });\n      return;\n    }\n\n    const ai = getGeminiAI();\n    const prompt = `\n      Voc\303\252 \303\251 um Coach de Carreira especialista em ATS (Applicant Tracking Systems) e recrutamento profissional no mercado lus\303\263fono (incluindo Cabo Verde, Portugal e Brasil).\n      Analise o Curr\303\255culo fornecido e alinhe-o com a Vaga de Emprego especificada.\n\n      Curr\303\255culo:\n      ${JSON.stringify(cvData, null, 2)}\n\n      Vaga de Emprego:\n      ${jobDescription}\n\n      Objetivos principais:\n      1. Calcule a afinidade atual (scoreBefore de 0 a 100) e a projetada se as altera\303\247\303\265es forem feitas (scoreAfter, idealmente de 85 a 100).\n      2. Identifique palavras-chave cruciais da vaga que est\303\243o ausentes no curr\303\255culo inicial (missingKeywords).\n      3. Sugira uma nova descri\303\247\303\243o de Perfil Profissional / Resumo (suggestedSummary) ultra-alinhada \303\240 vaga, mantendo a verdade sobre a experi\303\252ncia do candidato.\n      4. Para cada experi\303\252ncia de trabalho listada, sugira de 2 a 3 bullet points altamente impactantes baseados no m\303\251todo Estrela (Situa\303\247\303\243o, Tarefa, A\303\247\303\243o, Resultado) com palavras de a\303\247\303\243o fortes e mencione por que isso ajuda (justification).\n      5. Liste pontos fortes do perfil candidato (strengthPoints).\n      6. Liste compet\303\252ncias recomendadas para adicionar na se\303\247\303\243o de habilidades (recommendedSkillsToAdd).\n\n      Gere a sua resposta em Portugu\303\252s estrito no formato de JSON que obede\303\247a ao esquema fornecido.\n    `;\n\n    const response = await ai.models.generateContent({\n      model: \"gemini-3.5-flash\",\n      contents: prompt,\n      config: {\n        responseMimeType: \"application/json\",\n        responseSchema: {\n          type: Type.OBJECT,\n          required: [\"scoreBefore\", \"scoreAfter\", \"missingKeywords\", \"suggestedSummary\", \"suggestedExperiences\", \"strengthPoints\", \"recommendedSkillsToAdd\"],\n          properties: {\n            scoreBefore: { type: Type.INTEGER, description: \"ATS score estimate out of 100 before changes\" },\n            scoreAfter: { type: Type.INTEGER, description: \"ATS score estimate out of 100 after changes\" },\n            missingKeywords: {\n              type: Type.ARRAY,\n              items: { type: Type.STRING },\n              description: \"High impact keywords present in the JD but missing from the resume\"\n            },\n            suggestedSummary: { type: Type.STRING, description: \"A tailored professional profile summary in Portuguese\" },\n            suggestedExperiences: {\n              type: Type.ARRAY,\n              items: {\n                type: Type.OBJECT,\n                required: [\"experienceId\", \"suggestedBulletPoints\", \"justification\"],\n                properties: {\n                  experienceId: { type: Type.STRING, description: \"The ID of the experience\" },\n                  suggestedBulletPoints: {\n                    type: Type.ARRAY,\n                    items: { type: Type.STRING },\n                    description: \"Tailored bullet points for this work experience\"\n                  },\n                  justification: { type: Type.STRING, description: \"Why these changes align well with the job\" }\n                }\n              }\n            },\n            strengthPoints: {\n              type: Type.ARRAY,\n              items: { type: Type.STRING },\n              description: \"Strengths identified in the candidate\'s history relative to the job\"\n            },\n            recommendedSkillsToAdd: {\n              type: Type.ARRAY,\n              items: { type: Type.STRING },\n              description: \"Habilidades, ferramentas ou metodologias sugeridas para incluir\"\n            }\n          }\n        }\n      }\n    });\n\n    const result = JSON.parse(response.text || \"{}\");\n    res.json(result);\n  } catch (error: any) {\n    console.error(\"Erro no optimize-cv:\", error);\n    res.status(500).json({ error: \"INTERNAL_SERVER_ERROR\", message: error.message || \"Erro desconhecido\" });\n  }\n});"
        replacement_content: "// API: Optimize CV to Job Description\napp.post(\"/api/optimize-cv\", checkApiKey, async (req, res) => {\n  try {\n    const { cvData, jobDescription, optimizeForGupy, jobUrlOrTitle } = req.body;\n    if (!cvData || !jobDescription) {\n      res.status(400).json({ error: \"Par\303\242metros inv\303\241lidos: cvData e jobDescription s\303\243o obrigat\303\263rios\" });\n      return;\n    }\n\n    const ai = getGeminiAI();\n    const prompt = `\n      Voc\303\252 \303\251 um Coach de Carreira especialista em ATS (Applicant Tracking Systems) e recrutamento profissional, com profundo conhecimento nos rob\303\264s da Gupy e outros automatizadores de recrutamento do mercado lus\303\263fono.\n      Analise o Curr\303\255culo fornecido e alinhe-o com a Vaga de Emprego especificada.\n\n      Curr\303\255culo:\n      ${JSON.stringify(cvData, null, 2)}\n\n      Vaga de Emprego:\n      ${jobDescription}\n\n      ${jobUrlOrTitle ? `Adicionalmente, o usu\303\241rio buscou a vaga na internet com o seguinte link ou t\303\255tulo: \"${jobUrlOrTitle}\". Pesquise ativamente no Google por mais detalhes sobre esta vaga ou os requisitos da empresa, se aplic\303\241vel, e use essa pesquisa para enriquecer sua an\303\241lise de palavras-chave, resumo e compet\303\252ncias.` : \"\"}\n\n      ${optimizeForGupy ? `O usu\303\241rio ativou a otimiza\303\247\303\243o espec\303\255fica para a Gupy (rob\303\264s de triagem automatizada). Preste muita aten\303\247\303\243o em como o algoritmo de ordena\303\247\303\243o da Gupy funciona (relev\303\242ncia sem\303\242ntica extrema, correspond\303\252ncia exata de compet\303\252ncias inseridas no cadastro, formata\303\247\303\243o limpa do PDF, preenchimento sequencial das experi\303\252ncias). Calcule o \'gupyCompatibilityScore\' estimando a chance real dele ser classificado no topo pelo rob\303\264 da Gupy, e forne\303\247a no campo \'gupyAdvice\' uma lista de 4 a 6 dicas estrat\303\251gicas de preenchimento de perfil e adequa\303\247\303\243o de curr\303\255culo na plataforma Gupy para esta vaga.` : `Mesmo que a otimiza\303\247\303\243o espec\303\255fica para a Gupy n\303\243o tenha sido explicitada de forma priorit\303\241ria, forne\303\247a no campo \'gupyCompatibilityScore\' uma pontua\303\247\303\243o geral estimada para rob\303\264s e no \'gupyAdvice\' pelo menos 2 a 3 conselhos de bom senso para triagens automatizadas em geral.`}\n\n      Objetivos principais:\n      1. Calcule a afinidade atual (scoreBefore de 0 a 100) e a projetada se as altera\303\247\303\265es forem feitas (scoreAfter, idealmente de 85 a 100).\n      2. Identifique palavras-chave cruciais da vaga que est\303\243o ausentes no curr\303\255culo inicial (missingKeywords).\n      3. Sugira uma nova descri\303\247\303\243o de Perfil Profissional / Resumo (suggestedSummary) ultra-alinhada \303\240 vaga, mantendo a verdade sobre a experi\303\252ncia do candidato.\n      4. Para cada experi\303\252ncia de trabalho listada, sugira de 2 a 3 bullet points altamente impactantes baseados no m\303\251todo Estrela (Situa\303\247\303\243o, Tarefa, A\303\247\303\243o, Resultado) com palavras de a\303\247\303\243o fortes e mencione por que isso ajuda (justification).\n      5. Liste pontos fortes do perfil candidato (strengthPoints).\n      6. Liste compet\303\252ncias recomendadas para adicionar na se\303\247\303\243o de habilidades (recommendedSkillsToAdd).\n      7. Preencha as propriedades \'gupyCompatibilityScore\', \'gupyAdvice\' e \'internetVagaSearchInfo\' (onde \'internetVagaSearchInfo\' deve relatar as descobertas espec\303\255ficas da busca na web da vaga se \'jobUrlOrTitle\' foi fornecida, ou estar vazio/coment\303\241rio breve caso contr\303\241rio).\n\n      Gere a sua resposta em Portugu\303\252s estrito no formato de JSON que obede\303\247a ao esquema fornecido.\n    `;\n\n    const config: any = {\n      responseMimeType: \"application/json\",\n      responseSchema: {\n        type: Type.OBJECT,\n        required: [\n          \"scoreBefore\",\n          \"scoreAfter\",\n          \"missingKeywords\",\n          \"suggestedSummary\",\n          \"suggestedExperiences\",\n          \"strengthPoints\",\n          \"recommendedSkillsToAdd\",\n          \"gupyCompatibilityScore\",\n          \"gupyAdvice\",\n          \"internetVagaSearchInfo\"\n        ],\n        properties: {\n          scoreBefore: { type: Type.INTEGER, description: \"ATS score estimate out of 100 before changes\" },\n          scoreAfter: { type: Type.INTEGER, description: \"ATS score estimate out of 100 after changes\" },\n          missingKeywords: {\n            type: Type.ARRAY,\n            items: { type: Type.STRING },\n            description: \"High impact keywords present in the JD but missing from the resume\"\n          },\n          suggestedSummary: { type: Type.STRING, description: \"A tailored professional profile summary in Portuguese\" },\n          suggestedExperiences: {\n            type: Type.ARRAY,\n            items: {\n              type: Type.OBJECT,\n              required: [\"experienceId\", \"suggestedBulletPoints\", \"justification\"],\n              properties: {\n                experienceId: { type: Type.STRING, description: \"The ID of the experience\" },\n                suggestedBulletPoints: {\n                  type: Type.ARRAY,\n                  items: { type: Type.STRING },\n                  description: \"Tailored bullet points for this work experience\"\n                },\n                justification: { type: Type.STRING, description: \"Why these changes align well with the job\" }\n              }\n            }\n          },\n          strengthPoints: {\n            type: Type.ARRAY,\n            items: { type: Type.STRING },\n            description: \"Strengths identified in the candidate\'s history relative to the job\"\n          },\n          recommendedSkillsToAdd: {\n            type: Type.ARRAY,\n            items: { type: Type.STRING },\n            description: \"Habilidades, ferramentas ou metodologias sugeridas para incluir\"\n          },\n          gupyCompatibilityScore: { type: Type.INTEGER, description: \"Gupy compatibility score from 0 to 100\" },\n          gupyAdvice: {\n            type: Type.ARRAY,\n            items: { type: Type.STRING },\n            description: \"Conselhos espec\303\255ficos de preenchimento e otimiza\303\247\303\243o para passar no rob\303\264 da Gupy\"\n          },\n          internetVagaSearchInfo: { type: Type.STRING, description: \"Resultados ou insights da busca na web usando o link/t\303\255tulo da vaga fornecido\" }\n        }\n      }\n    };\n\n    if (jobUrlOrTitle) {\n      config.tools = [{ googleSearch: {} }];\n    }\n\n    const response = await ai.models.generateContent({\n      model: \"gemini-3.5-flash\",\n      contents: prompt,\n      config: config\n    });\n\n    const result = JSON.parse(response.text || \"{}\");\n    res.json(result);\n  } catch (error: any) {\n    console.error(\"Erro no optimize-cv:\", error);\n    res.status(500).json({ error: \"INTERNAL_SERVER_ERROR\", message: error.message || \"Erro desconhecido\" });\n  }\n});"
      }
      num_matches: 1
    }
  }
