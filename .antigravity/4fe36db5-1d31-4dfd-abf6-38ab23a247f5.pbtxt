      replacement_content: "          {/* Customized Paste Description */}\n          <div id=\"custom-paste-div\" className=\"space-y-1 pt-1\">\n            <label className=\"block text-xs font-semibold text-slate-700\">Descri\303\247\303\243o da Vaga de Trabalho / Requisitos</label>\n            <textarea\n              rows={8}\n              value={jobDescription}\n              onChange={(e) => {\n                setJobDescription(e.target.value);\n                setSelectedPresetId(-1); // Unset presets if manual edit\n              }}\n              placeholder=\"Cole aqui a descri\303\247\303\243o completa de atribui\303\247\303\265es e compet\303\252ncias requisitadas para a vaga...\"\n              className=\"w-full text-xs p-3 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition-all font-mono text-slate-700 resize-none\"\n            />\n          </div>\n\n          {/* Internet Job Search Box */}\n          <div id=\"internet-search-field-div\" className=\"space-y-1 pt-1 animate-fade-in\">\n            <label className=\"block text-xs font-semibold text-slate-700 flex items-center gap-1.5\">\n              <span className=\"w-1.5 h-3 bg-sky-500 rounded-full\" />\n              Link ou Nome da Vaga da Internet (Opcional)\n            </label>\n            <input\n              type=\"text\"\n              value={jobUrlOrTitle}\n              onChange={(e) => setJobUrlOrTitle(e.target.value)}\n              placeholder=\"Ex: https://portal.gupy.io/jobs/12345 ou Desenvolvedor Fullstack\"\n              className=\"w-full text-xs px-3 py-2.5 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition-all text-slate-700\"\n            />\n            <p className=\"text-[10px] text-slate-500 leading-normal\">\n              Nossa IA pesquisar\303\241 ativamente os requisitos extras dessa URL ou do cargo no Google para enriquecer seu curr\303\255culo.\n            </p>\n          </div>\n\n          {/* Gupy Robot Optimizer Toggle */}\n          <div id=\"gupy-toggle-container\" className=\"pt-2 animate-fade-in\">\n            <label className=\"relative flex items-start gap-3 p-3 bg-indigo-50/50 hover:bg-slate-50 border border-indigo-100 rounded-xl cursor-pointer select-none transition-all\">\n              <input\n                type=\"checkbox\"\n                checked={optimizeForGupy}\n                onChange={(e) => setOptimizeForGupy(e.target.checked)}\n                className=\"mt-1 rounded border-indigo-300 text-indigo-600 focus:ring-indigo-500/30 w-4 h-4 cursor-pointer\"\n              />\n              <div className=\"space-y-0.5\">\n                <span className=\"text-xs font-semibold text-indigo-950 flex items-center gap-1.5\">\n                  Ativar Otimiza\303\247\303\243o para Rob\303\264s Gupy \360\237\244\226\n                </span>\n                <p className=\"text-[10px] text-indigo-700 leading-tight\">\n                  Analisa e formata seu curr\303\255culo para passar pelos rob\303\264s autom\303\241ticos de classifica\303\247\303\243o da Gupy, aumentando sua nota de afinidade na vaga.\n                </p>\n              </div>\n            </label>\n          </div>\n\n          <button\n            id=\"optimize-submit-btn\"\n            type=\"button\"\n            disabled={loading || !jobDescription.trim()}\n            onClick={executeOptimization}\n            className={`w-full py-3 px-4 rounded-xl font-medium text-sm flex items-center justify-center gap-2 transition duration-200 ${\n              loading\n                ? \"bg-slate-100 text-slate-400 cursor-not-allowed\"\n                : \"bg-slate-900 hover:bg-slate-800 text-white shadow-md active:scale-[0.98]\"\n            }`}\n          >"
