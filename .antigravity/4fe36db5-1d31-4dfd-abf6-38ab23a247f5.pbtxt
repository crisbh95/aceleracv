Missing Keywords & Additions */}"
        replacement_content: "        {results && !loading && (\n          <div id=\"results-content-div\" className=\"space-y-6 animate-fade-in text-slate-800\">\n            {/* Score Comparison Header */}\n            <div className=\"bg-white border border-slate-100 rounded-2xl p-6 shadow-xs\">\n              <h3 className=\"font-display font-semibold text-sm text-slate-500 tracking-wider uppercase mb-4\">Afinidade com a Vaga (ATS Score)</h3>\n              <div className=\"grid grid-cols-2 gap-4\">\n                <div className=\"bg-slate-50/80 rounded-xl p-4 text-center border border-slate-100\">\n                  <span className=\"text-[11px] text-slate-400 font-medium block uppercase tracking-wider\">Afinidade Inicial</span>\n                  <span className=\"text-3xl font-display font-extrabold text-slate-500 block mt-1\">{results.scoreBefore}%</span>\n                  <div className=\"w-full bg-slate-200 h-1.5 rounded-full mt-2.5 overflow-hidden\">\n                    <div className=\"bg-slate-400/80 h-1.5 rounded-full\" style={{ width: `${results.scoreBefore}%` }} />\n                  </div>\n                </div>\n\n                <div className=\"bg-emerald-50/40 rounded-xl p-4 text-center border border-emerald-100/60\">\n                  <span className=\"text-[11px] text-emerald-600 font-bold block uppercase tracking-wider flex items-center justify-center gap-1\">\n                    <Sparkles className=\"w-3 h-3 text-emerald-500\" /> Potencial com IA\n                  </span>\n                  <span className=\"text-3xl font-display font-extrabold text-emerald-700 block mt-1\">{results.scoreAfter}%</span>\n                  <div className=\"w-full bg-emerald-200 h-1.5 rounded-full mt-2.5 overflow-hidden\">\n                    <div className=\"bg-emerald-600 h-1.5 rounded-full\" style={{ width: `${results.scoreAfter}%` }} />\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            {/* Gupy Compatibility Shield */}\n            {results.gupyCompatibilityScore !== undefined && (optimizeForGupy || (results.gupyAdvice && results.gupyAdvice.length > 0)) && (\n              <div className=\"bg-gradient-to-br from-indigo-50/50 to-indigo-100/10 border border-indigo-100 rounded-2xl p-6 shadow-xs space-y-4 animate-fade-in\">\n                <div className=\"flex items-center justify-between\">\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"px-2 py-0.5 bg-indigo-600 text-white rounded-md text-[10px] font-extrabold font-mono tracking-wider\">GUPY ATS</span>\n                    <h3 className=\"font-display font-semibold text-slate-800 text-sm\">Score de Compatibilidade Gupy</h3>\n                  </div>\n                  <span className=\"text-3xl font-display font-extrabold text-indigo-700 block\">{results.gupyCompatibilityScore}%</span>\n                </div>\n                <p className=\"text-slate-600 text-xs leading-relaxed\">\n                  O algoritmo de triagem automatizada da Gupy avalia o alinhamento de palavras-chave, preenchimento detalhado do curr\303\255culo e conformidade sint\303\241tica das compet\303\252ncias. Baseado nas corre\303\247\303\265es sugeridas, calculamos o score acima.\n                </p>\n                {results.gupyAdvice && results.gupyAdvice.length > 0 && (\n                  <div className=\"space-y-2 pt-3 border-t border-indigo-100/60\">\n                    <h4 className=\"text-xs font-semibold text-indigo-950 flex items-center gap-1.5\">\n                      <Check className=\"w-4 h-4 text-emerald-600\" />\n                      Estrat\303\251gias para Passar pelo Rob\303\264 da Gupy:\n                    </h4>\n                    <ul className=\"grid grid-cols-1 md:grid-cols-2 gap-2 mt-1\">\n                      {results.gupyAdvice.map((advice, i) => (\n                        <li key={i} className=\"text-xs text-slate-700 bg-white/70 border border-indigo-50 p-2 rounded-xl flex items-start gap-2\">\n                          <span className=\"w-1.5 h-1.5 bg-indigo-500 rounded-full shrink-0 mt-2\" />\n                          <span>{advice}</span>\n                        </li>\n                      ))}\n                    </ul>\n                  </div>\n                )}\n              </div>\n            )}\n\n            {/* Internet Job Live Analysis Insights */}\n            {jobUrlOrTitle && results.internetVagaSearchInfo && (\n              <div className=\"bg-sky-50/50 border border-sky-100 rounded-2xl p-6 shadow-xs space-y-3 animate-fade-in\">\n                <h3 className=\"font-display font-semibold text-sky-950 text-xs flex items-center gap-2 uppercase tracking-wide\">\n                  <span className=\"w-2 h-2 bg-sky-500 rounded-full animate-ping\" />\n                  Insights extra\303\255dos da vaga na Internet\n                </h3>\n                <div className=\"text-xs leading-relaxed text-sky-900 bg-white/60 border border-sky-100/60 p-4 rounded-xl leading-relaxed\">\n                  {results.internetVagaSearchInfo}\n                </div>\n              </div>\n            )}\n\n            {/* Missing Keywords & Additions */}"
      }
      num_matches: 1
    }
  }
}
