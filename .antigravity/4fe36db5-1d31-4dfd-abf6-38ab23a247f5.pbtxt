    replacement_chunks {
      replacement_content: "import { CVData } from \"./types\";\n\nexport const DEV_MOCK_CV: CVData = {\n  fullName: \"Carlos Jorge Silva\",\n  email: \"carlos.silva@cvmail.cv\",\n  phone: \"+238 991 23 45\",\n  location: \"Praia, Cabo Verde\",\n  website: \"linkedin.com/in/carlos-jorge-cv\",\n  summary: \"Desenvolvedor de Software J\303\272nior com conhecimento em tecnologias web modernas. Apaixonado por criar solu\303\247\303\265es de software eficientes que agregam valor real, com forte foco em colabora\303\247\303\243o de equipas e boas pr\303\241ticas de c\303\263digo.\",\n  experience: [\n    {\n      id: \"exp1\",\n      role: \"Desenvolvedor Frontend J\303\272nior\",\n      company: \"CV Telecom (Cabo Verde Telecom)\",\n      location: \"Praia, Santiago\",\n      startDate: \"Janeiro de 2024\",\n      endDate: \"Presente\",\n      description: \"Trabalho na manuten\303\247\303\243o e cria\303\247\303\243o de novos m\303\263dulos no portal interno de atendimento ao cliente. Ajudo a otimizar consultas leves e a implementar layouts responsivos simples em HTML, CSS e JavaScript.\"\n    },\n    {\n      id: \"exp2\",\n      role: \"Estagi\303\241rio de TI\",\n      company: \"Minist\303\251rio das Finan\303\247as de Cabo Verde\",\n      location: \"Praia, Santiago\",\n      startDate: \"Junho de 2023\",\n      endDate: \"Dezembro de 2023\",\n      description: \"Suporte geral ao departamento de inform\303\241tica. Auxiliei no suporte di\303\241rio ao utilizador, resolu\303\247\303\243o de problemas simples de rede e manuten\303\247\303\243o corretiva de bases de dados locais.\"\n    }\n  ],\n  education: [\n    {\n      id: \"edu1\",\n      degree: \"Licenciatura em Engenharia Inform\303\241tica\",\n      fieldOfStudy: \"Engenharia de Redes e Sistemas\",\n      school: \"Universidade de Cabo Verde (Uni-CV)\",\n      location: \"Praia, Cabo Verde\",\n      startDate: \"2019\",\n      endDate: \"2023\"\n    }\n  ],\n  skills: [\n    \"JavaScript\",\n    \"HTML5 & CSS3\",\n    \"React (B\303\241sico)\",\n    \"Bases de Dados SQL\",\n    \"Git & GitHub\",\n    \"Resolu\303\247\303\243o de Problemas\",\n    \"Suporte de Rede\"\n  ],\n  languages: [\n    \"Crioulo de Cabo Verde (Nativo)\",\n    \"Portugu\303\252s (Fluente)\",\n    \"Ingl\303\252s (Interm\303\251dio)\"\n  ]\n};\n\nexport const ADM_MOCK_CV: CVData = {\n  fullName: \"Mariana Neves Semedo\",\n  email: \"mariana.semedo@gmail.com\",\n  phone: \"+238 985 11 22\",\n  location: \"Mindelo, S\303\243o Vicente, Cabo Verde\",\n  website: \"linkedin.com/in/mariana-neves-cv\",\n  summary: \"Profissional de Apoio Administrativo e Atendimento ao Cliente com mais de 3 anos de experi\303\252ncia em coordena\303\247\303\243o de escrit\303\263rio e gest\303\243o de opera\303\247\303\265es na \303\241rea comercial. Conhecida pela excelente comunica\303\247\303\243o interpessoal e organiza\303\247\303\243o rigorosa.\",\n  experience: [\n    {\n      id: \"exp1\",\n      role: \"Assistente Administrativa S\303\251nior\",\n      company: \"Unitel T+ (Telecomunica\303\247\303\265es)\",\n      location: \"Mindelo, Cabo Verde\",\n      startDate: \"Mar\303\247o de 2022\",\n      endDate: \"Presente\",\n      description: \"Respons\303\241vel pela triagem de contactos, atendimento telef\303\263nico e controle de agenda da equipa diretiva. Desenvolvi uma nova planilha de controle financeiro mensal que reduziu erros de fatura\303\247\303\243o em 15%.\"\n    },\n    {\n      id: \"exp2\",\n      role: \"Rececionista e Apoio Comercial\",\n      company: \"Hotel Porto Grande\",\n      location: \"Mindelo, Cabo Verde\",\n      startDate: \"Outubro de 2020\",\n      endDate: \"Fevereiro de 2022\",\n      description: \"Atendimento caloroso a h\303\263spedes nacionais e internacionais, gest\303\243o de reservas de quartos, fatura\303\247\303\243o r\303\241pida e comunica\303\247\303\243o profissional ativa com parceiros tur\303\255sticos locais.\"\n    }\n  ],\n  education: [\n    {\n      id: \"edu1\",\n      degree: \"Curso Profissional de Secretariado Executivo e Rela\303\247\303\265es P\303\272blicas\",\n      fieldOfStudy: \"Eventos, Marketing e Secretariado\",\n      school: \"Escola de Hotelaria e Turismo de Cabo Verde (EHTCV)\",\n      location: \"Praia, Cabo Verde\",\n      startDate: \"2018\",\n      endDate: \"2020\"\n    }\n  ],\n  skills: [\n    \"Gest\303\243o de Escrit\303\263rio\",\n    \"Microsoft Office (Excel avan\303\247ado)\",\n    \"Fatura\303\247\303\243o & Fluxo de Caixa\",\n    \"Atendimento ao P\303\272blico\",\n    \"Rela\303\247\303\265es P\303\272blicas\",\n    \"Organiza\303\247\303\243o de Eventos Corporativos\"\n  ],\n  languages: [\n    \"Crioulo Cabo-verdiano (Nativo)\",\n    \"Portugu\303\252s (Fluente)\",\n    \"Franc\303\252s (Interm\303\251dio)\",\n    \"Ingl\303\252s (Fluente)\"\n  ]\n};\n\nexport const MOCK_JOB_DESCRIPTIONS = [\n  {\n    title: \"Desenvolvedor Full Stack J\303\272nior - Tech Startup\",\n    company: \"TechMind\",\n    description: \"Procuramos um Desenvolvedor Frontend/Full Stack J\303\272nior para se juntar \303\240 nossa equipa em r\303\241pida expans\303\243o. Requisitos principais: conhecimento consolidado em JavaScript moderno, React, Git, bases de dados relacionais e excelente comunica\303\247\303\243o t\303\251cnica. Oferecemos flexibilidade de trabalho h\303\255brido, mentoriza\303\247\303\243o por engenheiros seniores e a oportunidade de criar produtos digitais que impactam milhares de neg\303\263cios locais. Valorizamos profissionais proativos e que adoram resolver desafios complexos.\"\n  },\n  {\n    title: \"Gestor Comercial e Administrativo - Distribuidora Alian\303\247a\",\n    company: \"Alian\303\247a S.A.\",\n    description: \"Estamos a recrutar um profissional din\303\242mico para apoiar as nossas opera\303\247\303\265es financeiras e comerciais em Santiago e Mindelo. Procuramos compet\303\252ncias fortes em Microsoft Office (sobretudo Excel avan\303\247ado para an\303\241lise de dados), facilidade com rotinas de fatura\303\247\303\243o e concilia\303\247\303\243o banc\303\241ria, flu\303\252ncia em portugu\303\252s e bom relacionamento no atendimento empresarial direto para fideliza\303\247\303\243o de clientes nacionais e corporativos.\"\n  },\n  {\n    title: \"Especialista em Suporte e Redes de Computadores\",\n    company: \"GlobalNet S.A.\",\n    description: \"Engenheiro ou T\303\251cnico de TI cobi\303\247ado para gerir rede corporativa local e suporte de hardware/servidores. Requisitos: Resolu\303\247\303\243o \303\241gil de problemas em redes locais (TCP/IP, switches, roteadores), seguran\303\247a da informa\303\247\303\243o b\303\241sica, atendimento \303\240s necessidades inform\303\241ticas das equipas administrativas e capacidade de documentar procedimentos operacionais.\"\n  }\n];\n"
    }
