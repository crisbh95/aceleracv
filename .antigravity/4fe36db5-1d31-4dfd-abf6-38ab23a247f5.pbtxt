  file_change {
    absolute_path_uri: "file:///src/components/CVOptimizer.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport React, { useState } from \"react\";\nimport { CVData, OptimizationResult } from \"../types\";\nimport { MOCK_JOB_DESCRIPTIONS } from \"../mockData\";\nimport { Sparkles, ArrowRight, Check, Copy, AlertTriangle, ChevronRight, RefreshCw, BarChart2, CheckCircle2, Bookmark } from \"lucide-react\";\n\ninterface CVOptimizerProps {\n  cvData: CVData;\n  onUpdateCV: (updatedData: CVData) => void;\n}\n\nexport default function CVOptimizer({ cvData, onUpdateCV }: CVOptimizerProps) {\n  const [jobDescription, setJobDescription] = useState(MOCK_JOB_DESCRIPTIONS[0].description);\n  const [selectedPresetId, setSelectedPresetId] = useState(0);\n  const [loading, setLoading] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n  const [results, setResults] = useState<OptimizationResult | null>(null);\n  const [copiedTextId, setCopiedTextId] = useState<string | null>(null);\n\n  const handleSelectPreset = (index: number) => {\n    setSelectedPresetId(index);\n    setJobDescription(MOCK_JOB_DESCRIPTIONS[index].description);\n  };\n\n  const handleCopy = (text: string, id: string) => {\n    navigator.clipboard.writeText(text);\n    setCopiedTextId(id);\n    setTimeout(() => {\n      setCopiedTextId(null);\n    }, 2000);\n  };\n\n  const handleApplySummary = () => {\n    if (results && results.suggestedSummary) {\n      onUpdateCV({\n        ...cvData,\n        summary: results.suggestedSummary\n      });\n      alert(\"Seu resumo oficial no perfil foi atualizado com sucesso!\");\n    }\n  };\n\n  const executeOptimization = async () => {\n    setLoading(true);\n    setError(null);\n    try {\n      const response = await fetch(\"/api/optimize-cv\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({ cvData, jobDescription })\n      });\n\n      const data = await response.json();\n      if (!response.ok) {\n        throw new Error(data.message || \"Falha na comunica\303\247\303\243o com o servidor.\");\n      }\n\n      if (data.error === \"API_KEY_MISSING\") {\n        throw new Error(data.message);\n      }\n\n      setResults(data);\n    } catch (err: any) {\n      console.error(err);\n      setError(err.message || \"Ocorreu um erro ao processar. Tente novamente.\");\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  return (\n    <div id=\"cv-optimizer-root\" className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 animate-fade-in\">\n      {/* Input Side (4 cols or 5 cols depending on layout) */}\n      <div id=\"optimizer-inputs-panel\" className=\"lg:col-span-5 space-y-6\">\n        <div className=\"bg-white border border-slate-100 rounded-2xl p-6 shadow-xs space-y-4\">\n          <h2 id=\"optimizer-input-title\" className=\"text-slate-800 font-display font-semibold text-lg flex items-center gap-2\">\n            <Bookmark className=\"w-5 h-5 text-emerald-600\" />\n            1. Carregar Detalhes da Vaga\n          </h2>\n          <p className=\"text-slate-500 text-xs\">\n            Selecione uma vaga de exemplo ou cole abaixo a vaga real que encontrou no LinkedIn, Netemprego ou no portal oficial da empresa.\n          </p>\n\n          {/* Job Presets */}\n          <div id=\"preset-buttons-group\" className=\"flex flex-col gap-2\">\n            {MOCK_JOB_DESCRIPTIONS.map((preset, idx) => (\n              <button\n                key={idx}\n                type=\"button\"\n                onClick={() => handleSelectPreset(idx)}\n                className={`text-left text-xs px-3.5 py-3 rounded-xl border transition-all flex items-start justify-between gap-2 ${\n                  selectedPresetId === idx\n                    ? \"bg-emerald-50/70 border-emerald-500 text-emerald-950 font-medium\"\n                    : \"bg-slate-50 border-slate-100 text-slate-700 hover:bg-slate-100/50\"\n                }`}\n              >\n                <div>\n                  <p className=\"font-semibold\">{preset.title}</p>\n                  <p className=\"text-[11px] text-slate-500 mt-0.5\">{preset.company}</p>\n                </div>\n                {selectedPresetId === idx && <CheckCircle2 className=\"w-4 h-4 text-emerald-600 shrink-0 mt-0.5\" />}\n              </button>\n            ))}\n          </div>\n\n          {/* Customized Paste Description */}\n          <div id=\"custom-paste-div\" className=\"space-y-1 pt-1\">\n            <label className=\"block text-xs font-medium text-slate-600\">Descri\303\247\303\243o da Vaga de Trabalho</label>\n            <textarea\n              rows={8}\n              value={jobDescription}\n              onChange={(e) => {\n                setJobDescription(e.target.value);\n                setSelectedPresetId(-1); // Unset presets if manual edit\n              }}\n              placeholder=\"Cole aqui a descri\303\247\303\243o completa de atribui\303\247\303\265es e compet\303\252ncias requisitadas para a vaga...\"\n              className=\"w-full text-xs p-3 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition-all font-mono text-slate-700 resize-none\"\n            />\n          </div>\n\n          <button\n            id=\"optimize-submit-btn\"\n            type=\"button\"\n            disabled={loading || !jobDescription.trim()}\n            onClick={executeOptimization}\n            className={`w-full py-3 px-4 rounded-xl font-medium text-sm flex items-center justify-center gap-2 transition duration-200 ${\n              loading\n                ? \"bg-slate-100 text-slate-400 cursor-not-allowed\"\n                : \"bg-slate-900 hover:bg-slate-800 text-white shadow-md active:scale-[0.98]\"\n            }`}\n          >\n            {loading ? (\n              <>\n                <RefreshCw className=\"w-4 h-4 animate-spin\" />\n                Analisando Curr\303\255culo & Vaga com IA...\n              </>\n            ) : (\n              <>\n                <Sparkles className=\"w-4 h-4 text-emerald-400\" />\n                Alinhar Curr\303\255culo \303\240 Vaga\n              </>\n            )}\n          </button>\n        </div>\n      </div>\n\n      {/* Output / Results Side */}\n      <div id=\"optimizer-results-panel\" className=\"lg:col-span-7\">\n        {error && (\n          <div id=\"error-card\" className=\"bg-rose-50 border border-rose-100 rounded-2xl p-5 text-rose-900 flex items-start gap-3.5 mb-6 animate-fade-in\">\n            <AlertTriangle className=\"w-5 h-5 text-rose-500 shrink-0 mt-0.5\" />\n            <div className=\"space-y-2\">\n              <h4 className=\"font-semibold text-sm\">N\303\243o foi poss\303\255vel otimizar seu CV</h4>\n              <p className=\"text-xs text-rose-700 leading-relaxed\">{error}</p>\n              {error.includes(\"GEMINI_API_KEY\") && (\n                <div className=\"bg-white/80 border border-slate-100 rounded-xl p-3 mt-2 text-xs text-slate-700\">\n                  <p className=\"font-semibold\">Como configurar a chave:</p>\n                  <ol className=\"list-decimal pl-4 space-y-1 mt-1 text-[11px]\">\n                    <li>Clique no menu <strong>Settings</strong> do AI Studio (canto superior ou lateral).</li>\n                    <li>V\303\241 para a se\303\247\303\243o <strong>Secrets</strong>.</li>\n                    <li>Adicione a vari\303\241vel <strong>GEMINI_API_KEY</strong> com sua chave do Google Gemini.</li>\n                    <li>Volte e recarregue a otimiza\303\247\303\243o!</li>\n                  </ol>\n                </div>\n              )}\n            </div>\n          </div>\n        )}\n\n        {!results && !loading && !error && (\n          <div id=\"pre-state\" className=\"h-full min-h-[400px] border-2 border-dashed border-slate-100 rounded-2xl p-8 flex flex-col items-center justify-center text-center bg-slate-50/30\">\n            <BarChart2 className=\"w-12 h-12 text-slate-300 stroke-[1.5] mb-3\" />\n            <h3 className=\"font-display font-medium text-slate-700 text-base\">Relat\303\263rio de Otimiza\303\247\303\243o ATS</h3>\n            <p className=\"text-slate-400 text-xs max-w-sm mt-1 leading-relaxed\">\n              O seu curr\303\255culo ainda n\303\243o foi analisado. Clique em <strong>\"Alinhar Curr\303\255culo ao Cargo\"</strong> \303\240 esquerda para iniciar o diagn\303\263stico de compatibilidade profissional.\n            </p>\n          </div>\n        )}\n\n        {loading && (\n          <div id=\"loading-state\" className=\"h-full min-h-[400px] bg-white border border-slate-100 rounded-2xl p-8 flex flex-col items-center justify-center text-center space-y-4\">\n            <div className=\"relative flex items-center justify-center\">\n              <div className=\"w-12 h-12 rounded-full border-4 border-emerald-200 border-t-emerald-600 animate-spin\" />\n              <Sparkles className=\"w-5 h-5 text-emerald-500 absolute animate-pulse\" />\n            </div>\n            <div>\n              <h3 className=\"font-display font-medium text-slate-800 text-base\">Analisando o Alinhamento</h3>\n              <p className=\"text-slate-400 text-xs max-w-xs mt-1 leading-relaxed\">\n                A IA est\303\241 a dissecar os requisitos t\303\251cnicos da vaga, comparando as suas experi\303\252ncias passadas e reconfigurando os bullets com o m\303\251todo STAR...\n              </p>\n            </div>\n          </div>\n        )}\n\n        {results && !loading && (\n          <div id=\"results-content-div\" className=\"space-y-6 animate-fade-in text-slate-800\">\n            {/* Score Comparison Header */}\n            <div className=\"bg-white border border-slate-100 rounded-2xl p-6 shadow-xs\">\n              <h3 className=\"font-display font-semibold text-sm text-slate-500 tracking-wider uppercase mb-4\">Afinidade com a Vaga (ATS Score)</h3>\n              <div className=\"grid grid-cols-2 gap-4\">\n                <div className=\"bg-slate-50/80 rounded-xl p-4 text-center border border-slate-100\">\n                  <span className=\"text-[11px] text-slate-400 font-medium block uppercase tracking-wider\">Afinidade Inicial</span>\n                  <span className=\"text-3xl font-display font-extrabold text-slate-500 block mt-1\">{results.scoreBefore}%</span>\n                  <div className=\"w-full bg-slate-200 h-1.5 rounded-full mt-2.5 overflow-hidden\">\n                    <div className=\"bg-slate-400 h-1.5 rounded-fullTransition\" style={{ width: `${results.scoreBefore}%` }} />\n                  </div>\n                </div>\n\n                <div className=\"bg-emerald-50/40 rounded-xl p-4 text-center border border-emerald-100/60\">\n                  <span className=\"text-[11px] text-emerald-600 font-bold block uppercase tracking-wider flex items-center justify-center gap-1\">\n                    <Sparkles className=\"w-3 h-3 text-emerald-500\" /> Potencial com IA\n                  </span>\n                  <span className=\"text-3xl font-display font-extrabold text-emerald-700 block mt-1\">{results.scoreAfter}%</span>\n                  <div className=\"w-full bg-emerald-200 h-1.5 rounded-full mt-2.5 overflow-hidden\">\n                    <div className=\"bg-emerald-600 h-1.5 rounded-full\" style={{ width: `${results.scoreAfter}%` }} />\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            {/* Missing Keywords & Additions */}\n            <div className=\"bg-white border border-slate-100 rounded-2xl p-6 shadow-xs space-y-4\">\n              <h3 className=\"font-display font-semibold text-slate-700 text-sm flex items-center gap-2\">\n                <span className=\"w-1.5 h-3 bg-rose-500 rounded-full\" />\n                Palavras-chave em Falta no Seu CV Inicial\n              </h3>\n              <p className=\"text-slate-500 text-xs\">\n                Estes s\303\243o termos cruciais que os rob\303\264s de recrutamento buscam neste cargo e que n\303\243o identificamos na vers\303\243o inicial do seu CV:\n              </p>\n              <div className=\"flex flex-wrap gap-1.5\">\n                {results.missingKeywords.map((kw, i) => (\n                  <span key={i} className=\"text-xs px-2.5 py-1 bg-slate-50 text-slate-700 rounded-lg border border-slate-200/50 flex items-center gap-1\">\n                    <span className=\"w-1 h-1 bg-rose-500 rounded-full\" />\n                    {kw}\n                  </span>\n                ))}\n                {results.missingKeywords.length === 0 && (\n                  <span className=\"text-xs text-emerald-600 font-medium\">Parab\303\251ns! Nenhuma palavra-chave importante est\303\241 em falta.</span>\n                )}\n              </div>\n\n              {results.recommendedSkillsToAdd.length > 0 && (\n                <div className=\"pt-2 border-t border-slate-50 space-y-2\">\n                  <h4 className=\"text-xs font-semibold text-slate-700\">Compet\303\252ncias adicionais sugeridas para incluir:</h4>\n                  <div className=\"flex flex-wrap gap-1.5\">\n                    {results.recommendedSkillsToAdd.map((skill, i) => (\n                      <span key={i} className=\"text-xs px-2.5 py-1 bg-emerald-50 text-emerald-800 rounded-lg border border-emerald-100/50\">\n                        + {skill}\n                      </span>\n                    ))}\n                  </div>\n                </div>\n              )}\n            </div>\n\n            {/* Profile Summary Sugestion */}\n            <div className=\"bg-white border border-slate-100 rounded-2xl p-6 shadow-xs space-y-3\">\n              <div className=\"flex justify-between items-center\">\n                <h3 className=\"font-display font-semibold text-slate-800 text-sm flex items-center gap-2\">\n                  <span className=\"w-1.5 h-3 bg-emerald-500 rounded-full\" />\n                  Novo Resumo Profissional Sugerido (IA)\n                </h3>\n                <button\n                  type=\"button\"\n                  onClick={() => handleCopy(results.suggestedSummary, \"summary\")}\n                  className=\"p-1.5 text-slate-400 hover:text-emerald-600 transition flex items-center gap-1 text-[11px] font-medium\"\n                  title=\"Copiar resumo\"\n                >\n                  {copiedTextId === \"summary\" ? (\n                    <>\n                      <Check className=\"w-3.5 h-3.5 text-emerald-600\" />\n                      Copiar\n                    </>\n                  ) : (\n                    <>\n                      <Copy className=\"w-3.5 h-3.5\" />\n                      Copiar\n                    </>\n                  )}\n                </button>\n              </div>\n              <p className=\"text-xs text-slate-700 bg-slate-50 border border-slate-100 p-4 rounded-xl leading-relaxed italic\">\n                \"{results.suggestedSummary}\"\n              </p>\n              <button\n                type=\"button\"\n                onClick={handleApplySummary}\n                className=\"w-full text-center py-2 bg-emerald-50 hover:bg-emerald-100/75 border border-emerald-200/50 text-emerald-800 rounded-xl text-xs font-medium transition\"\n              >\n                Atualizar meu CV Oficial com este novo resumo!\n              </button>\n            </div>\n\n            {/* Experiences Suggestions */}\n            {results.suggestedExperiences.map((item) => {\n              const originalExp = cvData.experience.find(exp => exp.id === item.experienceId);\n              if (!originalExp) return null;\n              return (\n                <div key={item.experienceId} className=\"bg-white border border-slate-100 rounded-2xl p-6 shadow-xs space-y-4\">\n                  <div className=\"border-b border-slate-50 pb-2\">\n                    <span className=\"text-[10px] uppercase font-bold tracking-wider text-slate-400\">CARGO</span>\n                    <h4 className=\"font-semibold text-sm text-slate-800 leading-tight mt-0.5\">{originalExp.role} @ {originalExp.company}</h4>\n                  </div>\n\n                  <div className=\"space-y-3\">\n                    <p className=\"text-xs font-semibold text-slate-700\">Marcadores de Sucesso Sugeridos (Cole no seu CV):</p>\n                    <ul className=\"space-y-2.5\">\n                      {item.suggestedBulletPoints.map((bullet, bIdx) => {\n                        const copyId = `${item.experienceId}_${bIdx}`;\n                        return (\n                          <li key={bIdx} className=\"text-xs p-3 bg-slate-50/60 hover:bg-slate-50 rounded-xl flex items-start justify-between gap-4 border border-slate-100/40\">\n                            <span className=\"leading-relaxed text-slate-700\">{bullet}</span>\n                            <button\n                              type=\"button\"\n                              onClick={() => handleCopy(bullet, copyId)}\n                              title=\"Copiar marcador\"\n                              className=\"text-slate-400 hover:text-emerald-600 shrink-0 mt-0.5 transition\"\n                            >\n                              {copiedTextId === copyId ? (\n                                <Check className=\"w-3.5 h-3.5 text-emerald-600\" />\n                              ) : (\n                                <Copy className=\"w-3.5 h-3.5\" />\n                              )}\n                            </button>\n                          </li>\n                        );\n                      })}\n                    </ul>\n\n                    {item.justification && (\n                      <div className=\"bg-emerald-50/30 border border-emerald-100/40 p-3.5 rounded-xl mt-2 text-[11px] leading-relaxed text-slate-600 flex gap-2\">\n                        <span className=\"font-semibold text-emerald-800 shrink-0\">Estrat\303\251gia ATS:</span>\n                        <span>{item.justification}</span>\n                      </div>\n                    )}\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        )}\n      </div>\n    </div>\n  );\n}\n"
    }
