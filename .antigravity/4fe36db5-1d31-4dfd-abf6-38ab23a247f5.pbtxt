    instruction: "Replace templates-selector-card with new Upload and Download module in ResumeForm"
    replacement_infos {
      original_chunk {
        target_content: "      {/* Templates Selector */}\n      <div id=\"templates-selector-card\" className=\"bg-gradient-to-r from-emerald-50 to-teal-50 border border-emerald-100 rounded-2xl p-6 shadow-xs flex flex-col md:flex-row justify-between items-start md:items-center gap-4\">\n        <div>\n          <h3 id=\"template-card-title\" className=\"text-emerald-950 font-display font-semibold text-lg flex items-center gap-2\">\n            <Sparkles className=\"w-5 h-5 text-emerald-600\" />\n            Precisa de um exemplo r\303\241pido para testar?\n          </h3>\n          <p id=\"template-card-description\" className=\"text-emerald-800 text-sm mt-1\">\n            Selecione e importe um perfil de exemplo completo para analisar seu rendimento com a Intelig\303\252ncia Artificial.\n          </p>\n        </div>\n        <div id=\"templates-buttons-div\" className=\"flex gap-2 w-full md:w-auto\">\n          <button\n            id=\"import-dev-btn\"\n            onClick={() => handleImport(\"dev\")}\n            className=\"flex-1 md:flex-none px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-medium text-xs rounded-xl transition duration-200 shadow-sm flex items-center justify-center gap-2\"\n          >\n            <RefreshCw className=\"w-3.5 h-3.5\" />\n            Perfil Inform\303\241tico (Dev)\n          </button>\n          <button\n            id=\"import-adm-btn\"\n            onClick={() => handleImport(\"adm\")}\n            className=\"flex-1 md:flex-none px-4 py-2 bg-teal-600 hover:bg-teal-700 text-white font-medium text-xs rounded-xl transition duration-200 shadow-sm flex items-center justify-center gap-2\"\n          >\n            <RefreshCw className=\"w-3.5 h-3.5\" />\n            Perfil Administrativo\n          </button>\n        </div>\n      </div>"
        replacement_content: "      {/* Consolidado: Importa\303\247\303\243o de Dados, Download e Upload com IA */}\n      <div id=\"import-upload-container\" className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n        \n        {/* Upload de arquivo de Curr\303\255culo Inteligente (Esquerda) */}\n        <div id=\"resume-upload-card\" className=\"lg:col-span-6 bg-white border border-slate-200/80 rounded-2xl p-6 shadow-xs flex flex-col justify-between whitespace-normal text-left\">\n          <div className=\"space-y-1 mb-4\">\n            <h3 id=\"upload-card-title\" className=\"text-slate-800 font-display font-semibold text-sm flex items-center gap-2\">\n              <UploadCloud className=\"w-5 h-5 text-emerald-600\" />\n              Preenchimento Autom\303\241tico via Upload \360\237\244\226\n            </h3>\n            <p id=\"upload-card-desc\" className=\"text-slate-505 text-xs\">\n              Deixe que a Intelig\303\252ncia Artificial fa\303\247a o trabalho pesado de preencher todos os seus dados pessoais, experi\303\252ncias e compet\303\252ncias de uma s\303\263 vez!\n            </p>\n          </div>\n\n          <div\n            id=\"drag-drop-zone\"\n            onDragEnter={handleDrag}\n            onDragOver={handleDrag}\n            onDragLeave={handleDrag}\n            onDrop={handleDrop}\n            className={`border-2 border-dashed rounded-xl p-5 text-center transition duration-200 flex flex-col items-center justify-center relative cursor-pointer min-h-[140px] ${\n              dragActive\n                ? \"border-emerald-600 bg-emerald-50/20\"\n                : \"border-slate-200 hover:border-emerald-500 hover:bg-slate-50/50\"\n            }`}\n          >\n            <input\n              type=\"file\"\n              id=\"cv-file-picker\"\n              className=\"absolute inset-0 w-full h-full opacity-0 cursor-pointer\"\n              onChange={handleFileChange}\n              accept=\".pdf,.txt,.docx,.doc,image/png,image/jpeg\"\n              disabled={uploading}\n            />\n\n            {uploading ? (\n              <div className=\"space-y-2 flex flex-col items-center\">\n                <Loader2 className=\"w-8 h-8 text-emerald-600 animate-spin\" />\n                <p className=\"text-xs font-semibold text-slate-700\">Preenchendo curr\303\255culo com IA do Gemini...</p>\n                <p className=\"text-[10px] text-slate-400\">Extraindo nome, contatos, compet\303\252ncias e descri\303\247\303\265es...</p>\n              </div>\n            ) : (\n              <div className=\"space-y-2 flex flex-col items-center\">\n                <div className=\"w-9 h-9 rounded-full bg-slate-50 flex items-center justify-center text-slate-400\">\n                  <UploadCloud className=\"w-4 h-4 text-slate-550\" />\n                </div>\n                <p className=\"text-xs font-medium text-slate-700\">\n                  <span className=\"text-emerald-600 font-bold\">Arraste seu curr\303\255culo aqui</span> ou clique para selecionar\n                </p>\n                <p className=\"text-[10px] text-slate-400\">PDF, TXT, DOCX ou Imagens de at\303\251 5MB</p>\n              </div>\n            )}\n          </div>\n\n          {uploadError && (\n            <div className=\"mt-3 p-3 bg-rose-50 border border-rose-100 rounded-xl text-rose-900 flex items-start gap-2 animate-fade-in text-[11px]\">\n              <AlertCircle className=\"w-4 h-4 text-rose-500 shrink-0 mt-0.5\" />\n              <span>{uploadError}</span>\n            </div>\n          )}\n        </div>\n\n        {/* Perfis Base e Download do Curr\303\255culo Pr\303\263 (Direita) */}\n        <div id=\"quick-presets-downloads-card\" className=\"lg:col-span-6 bg-gradient-to-r from-emerald-50/70 to-teal-50/30 border border-emerald-100 rounded-2xl p-6 shadow-xs flex flex-col justify-between text-left\">\n          <div className=\"space-y-1 mb-4\">\n            <h3 id=\"downloads-card-title\" className=\"text-emerald-950 font-display font-semibold text-sm flex items-center gap-2\">\n              <Sparkles className=\"w-5 h-5 text-emerald-600\" />\n              Presets Exemplo & Exporta\303\247\303\243o\n            </h3>\n            <p id=\"downloads-card-desc\" className=\"text-emerald-800 text-xs\">\n              Simule curr\303\255culos modelos para testar a plataforma, ou fa\303\247a o download das notas modificadas.\n            </p>\n          </div>\n\n          <div className=\"space-y-3 pt-2\">\n            <div className=\"flex flex-col sm:flex-row gap-2\">\n              <button\n                id=\"import-dev-btn\"\n                type=\"button\"\n                onClick={() => handleImport(\"dev\")}\n                className=\"flex-1 px-4 py-2.5 bg-slate-800 hover:bg-slate-950 text-white font-semibold text-xs rounded-xl transition duration-150 shadow-xs flex items-center justify-center gap-1.5 cursor-pointer\"\n              >\n                <RefreshCw className=\"w-3.5 h-3.5\" />\n                Perfil Inform\303\241tico (Dev)\n              </button>\n              <button\n                id=\"import-adm-btn\"\n                type=\"button\"\n                onClick={() => handleImport(\"adm\")}\n                className=\"flex-1 px-4 py-2.5 bg-teal-600 hover:bg-teal-700 text-white font-semibold text-xs rounded-xl transition duration-150 shadow-xs flex items-center justify-center gap-1.5 cursor-pointer\"\n              >\n                <RefreshCw className=\"w-3.5 h-3.5\" />\n                Perfil Administrativo\n              </button>\n            </div>\n\n            {/* Campo e Bot\303\243o para Baixar */}\n            <div id=\"export-actions-section\" className=\"pt-3 border-t border-emerald-100 border-dashed space-y-2\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-[11px] font-bold text-emerald-800 uppercase tracking-wider\">Exportar do AceleraCV</span>\n                <span className=\"text-[10px] bg-emerald-100 text-emerald-800 px-1.5 py-0.5 rounded font-mono font-medium\">Formato .MD / .TXT</span>\n              </div>\n              <button\n                id=\"download-resume-btn\"\n                type=\"button\"\n                onClick={handleDownloadMarkdown}\n                className=\"w-full py-3 px-4 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-xl shadow-xs transition duration-150 flex items-center justify-center gap-2 active:scale-95 cursor-pointer\"\n              >\n                <Download className=\"w-4 h-4\" />\n                Baixar Meu Curr\303\255culo Preenchido\n              </button>\n              <p className=\"text-[10px] text-emerald-850 text-center leading-normal\">\n                Baixa um arquivo de texto Markdown optimizado para Gupy, LinkedIn e outros motores ATS estruturais.\n              </p>\n            </div>\n          </div>\n        </div>\n\n      </div>"
      }
      num_matches: 1
    }
  }
}
